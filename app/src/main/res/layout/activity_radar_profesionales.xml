<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F7">

    <!-- CONTENEDOR SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 1. BARRA SUPERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <!-- Badge Ubicación -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_rounded"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="14sp"
                    android:layout_marginEnd="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="San Salvador, SV"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explorar Radar"
                        android:textSize="10sp"
                        android:textColor="#6B7280" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Campana de notificaciones -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_input_rounded"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:layout_marginEnd="10dp"
                android:contentDescription="Notificaciones" />

            <!-- Avatar de Perfil -->
            <ImageView
                android:id="@+id/btnPerfilRadar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#0B2545"
                android:padding="8dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Perfil" />
        </LinearLayout>

        <!-- 2. SUBBARRA DE BÚSQUEDA DE TÉCNICOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:background="#FFFFFF"
            android:elevation="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️  Buscando técnicos cerca de\nColonia Escalón, San Salvador ∨"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0B2545" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="🎛️"
                android:backgroundTint="#0B2545"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 3. FILTROS RÁPIDOS (CHIPS) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔧  Fontanería ✓"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#0B2545"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢  Disponibles ya"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️  Verificados"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 4. ÁREA DE MAPA CON RADAR CIRCULAR -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#E5E7EB">

            <!-- Fondo simulando radar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="🎯 [Radar Concéntrico - San Salvador]"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4B5563" />

            <!-- Pin: Roberto M. • 1.2 km (15 min) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginStart="-80dp"
                android:layout_marginTop="-60dp"
                android:background="#0B2545"
                android:text=" ⚡ Roberto M. • 1.2 km (15 min) "
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="6dp"
                android:elevation="4dp" />

            <!-- Pin: Carlos • 2.1km -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginStart="70dp"
                android:layout_marginTop="-30dp"
                android:background="#FFFFFF"
                android:text=" Carlos • 2.1km "
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:padding="5dp"
                android:elevation="4dp" />

            <!-- Pin: Elena • 1.8 km -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginStart="-70dp"
                android:layout_marginTop="50dp"
                android:background="#FFFFFF"
                android:text=" Elena • 1.8 km "
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:padding="5dp"
                android:elevation="4dp" />

            <!-- Pin: Mario • 2.7km -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginStart="60dp"
                android:layout_marginTop="40dp"
                android:background="#FFFFFF"
                android:text=" Mario • 2.7km "
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:padding="5dp"
                android:elevation="4dp" />

            <!-- Pin: Tú estás aquí (Centro) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="#0B2545"
                android:text="  📍 Tú estás aquí  "
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="8dp"
                android:elevation="4dp" />

            <!-- Estado del Radar bajo el mapa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 4 técnicos activos cerca"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#059669" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="≡  Más cercanos primero ∨"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937" />
            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

    <!-- 5. TARJETA FLOTANTE INFERIOR: ROBERTO MÉNDEZ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginTop="-16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tarjeta de Roberto Méndez -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#F8FAFC"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@mipmap/ic_launcher"
                            android:background="#E5E7EB"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Roberto Méndez" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Roberto Méndez"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" 🛡️ DUI "
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:background="#059669"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fontanero Master • Fugas y Tuberías"
                                android:textSize="12sp"
                                android:textColor="#4B5563"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="★ 4.9 (142)  •  🚲 1.2 km • 8 min"
                                android:textSize="11sp"
                                android:textColor="#D97706"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tarjeta interna de disponibilidad inmediata -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#E0F2FE"
                        android:padding="10dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡"
                            android:textSize="16sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Disponible de inmediato\nLlega con herramientas y repuestos"
                            android:textSize="11sp"
                            android:textColor="#0369A1"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tarifa estimada y Botones -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tarifa estimada"
                                android:textSize="9sp"
                                android:textColor="#9CA3AF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$20 – $35 USD"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnVerPerfilRadarPro"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Ver Perfil"
                            android:textSize="12sp"
                            android:textColor="#0B2545"
                            android:backgroundTint="#E2E8F0"
                            android:layout_marginEnd="8dp"
                            android:paddingHorizontal="12dp" />

                        <Button
                            android:id="@+id/btnPedirServicioRadar"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Pedir Servicio ➔"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#0B2545"
                            android:paddingHorizontal="12dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarjeta informativa de DUI comprobado al pie -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#EFF6FF"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Todos los profesionales cuentan con DUI comprobado y revisión de antecedentes de El Salvador."
                    android:textSize="11sp"
                    android:textColor="#1E40AF" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 6. BARRA DE NAVEGACIÓN INFERIOR (BOTTOM NAVIGATION) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textSize="10sp"
                android:textColor="#6B7280" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧭"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explorar"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#0284C7" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitudes"
                android:textSize="10sp"
                android:textColor="#6B7280" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensajes"
                android:textSize="10sp"
                android:textColor="#6B7280" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textSize="10sp"
                android:textColor="#6B7280" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

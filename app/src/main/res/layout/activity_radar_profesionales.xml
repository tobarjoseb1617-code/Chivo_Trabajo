<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- CONTENEDOR SUPERIOR -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical">
    <!-- 1. BARRA SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/ui_surface"
        android:elevation="2dp">
      <ImageView
          android:id="@+id/btnRegresarRadar"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:padding="12dp"
          android:src="@drawable/ic_m3_back"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:clickable="true"
          android:focusable="true"
          android:layout_marginEnd="8dp"
          android:contentDescription="Regresar"
          android:minHeight="48dp"
          app:tint="@color/ui_text"/>
      <!-- Badge Ubicación -->
      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/bg_input_rounded"
          android:paddingHorizontal="10dp"
          android:paddingVertical="6dp"
          android:layout_marginEnd="8dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_m3_shield"
            app:tint="@color/ui_primary"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="San Salvador, SV"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Explorar Radar"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
      </LinearLayout>
      <View
          android:layout_width="0dp"
          android:layout_height="0dp"
          android:layout_weight="1"/>
      <!-- Campana de notificaciones -->
      <ImageView
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:background="@drawable/bg_input_rounded"
          android:padding="8dp"
          android:src="@android:drawable/ic_menu_agenda"
          android:layout_marginEnd="10dp"
          android:contentDescription="Notificaciones"/>
      <!-- Avatar de Perfil -->
      <ImageView
          android:id="@+id/btnPerfilRadar"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:background="@color/ui_brand"
          android:padding="8dp"
          android:src="@mipmap/ic_launcher"
          android:contentDescription="Perfil"
          android:minHeight="48dp"/>
    </LinearLayout>
    <!-- 2. SUBBARRA DE BÚSQUEDA DE TÉCNICOS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/ui_surface"
        android:elevation="1dp">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Buscando técnicos cerca de\nColonia Escalón, San Salvador ∨"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <View
          android:layout_width="0dp"
          android:layout_height="0dp"
          android:layout_weight="1"/>
      <com.google.android.material.button.MaterialButton
          android:layout_width="38dp"
          android:layout_height="wrap_content"
          android:text=""
          style="@style/Widget.Chivo.Button"
          android:minHeight="48dp"
          app:icon="@drawable/ic_m3_tune"
          app:iconGravity="textStart"
          app:iconPadding="0dp"
          android:contentDescription="Compartir perfil"
          android:minWidth="48dp"/>
    </LinearLayout>
    <!-- 3. FILTROS RÁPIDOS (CHIPS) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">
      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fontanería"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@color/ui_brand"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp"
            android:drawableStart="@drawable/ic_m3_build"
            android:drawableTint="@color/ui_primary"
            android:drawablePadding="8dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponibles ya"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:background="@color/ui_surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verificados"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:background="@color/ui_surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:drawableStart="@drawable/ic_m3_shield"
            android:drawableTint="@color/ui_primary"
            android:drawablePadding="8dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
    </HorizontalScrollView>
    <!-- 4. ÁREA DE MAPA CON RADAR CIRCULAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/ui_outline">
      <!-- Fondo simulando radar -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:text="[Radar Concéntrico - San Salvador]"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text_secondary"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <!-- Pin: Roberto M. • 1.2 km (15 min) -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:layout_marginStart="-80dp"
          android:layout_marginTop="-60dp"
          android:background="@color/ui_brand"
          android:text="Roberto M. • 1.2 km (15 min)"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="#FFFFFF"
          android:padding="6dp"
          android:elevation="4dp"
          android:drawableStart="@drawable/ic_m3_bolt"
          android:drawableTint="@color/ui_primary"
          android:drawablePadding="8dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <!-- Pin: Carlos • 2.1km -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:layout_marginStart="70dp"
          android:layout_marginTop="-30dp"
          android:background="@color/ui_surface"
          android:text="Carlos • 2.1km"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:padding="5dp"
          android:elevation="4dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <!-- Pin: Elena • 1.8 km -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:layout_marginStart="-70dp"
          android:layout_marginTop="50dp"
          android:background="@color/ui_surface"
          android:text="Elena • 1.8 km"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:padding="5dp"
          android:elevation="4dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <!-- Pin: Mario • 2.7km -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:layout_marginStart="60dp"
          android:layout_marginTop="40dp"
          android:background="@color/ui_surface"
          android:text="Mario • 2.7km"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:padding="5dp"
          android:elevation="4dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <!-- Pin: Tú estás aquí (Centro) -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:background="@color/ui_brand"
          android:text="Tú estás aquí"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="#FFFFFF"
          android:padding="8dp"
          android:elevation="4dp"
          android:drawableStart="@drawable/ic_m3_location"
          android:drawableTint="@color/ui_primary"
          android:drawablePadding="8dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <!-- Estado del Radar bajo el mapa -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_alignParentBottom="true"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@color/ui_surface"
          android:paddingHorizontal="16dp"
          android:paddingVertical="10dp"
          android:elevation="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 técnicos activos cerca"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_success"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≡  Más cercanos primero ∨"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
    </RelativeLayout>
  </LinearLayout>
  <!-- 5. TARJETA FLOTANTE INFERIOR: ROBERTO MÉNDEZ -->
  <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:cardBackgroundColor="@color/ui_surface"
      android:layout_marginTop="-16dp"
      style="@style/Widget.Chivo.Card">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
      <!-- Tarjeta de Roberto Méndez -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_background"
          android:layout_marginBottom="12dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:layout_marginEnd="12dp"
                android:contentDescription="Roberto Méndez"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Roberto Méndez"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:layout_marginEnd="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DUI"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#059669"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:drawableStart="@drawable/ic_m3_shield"
                    android:drawableTint="@color/ui_primary"
                    android:drawablePadding="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
              </LinearLayout>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Fontanero Master • Fugas y Tuberías"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:layout_marginTop="2dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="4.9 (142)  •   1.2 km • 8 min"
                  android:textSize="14sp"
                  android:textColor="@color/ui_warning"
                  android:textStyle="bold"
                  android:layout_marginTop="2dp"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
          </LinearLayout>
          <!-- Tarjeta interna de disponibilidad inmediata -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@drawable/bg_m3_info"
              android:padding="10dp"
              android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_m3_bolt"
                app:tint="@color/ui_primary"
                android:importantForAccessibility="no"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disponible de inmediato\nLlega con herramientas y repuestos"
                android:textSize="14sp"
                android:textColor="@color/ui_primary"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <!-- Tarifa estimada y Botones -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Tarifa estimada"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="$20 – $35 usd"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerPerfilRadarPro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver Perfil"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Chivo.Button.Secondary"
                android:minHeight="48dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPedirServicioRadar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedir Servicio"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- Tarjeta informativa de DUI comprobado al pie -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/bg_m3_info"
          android:padding="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_m3_shield"
            app:tint="@color/ui_primary"
            android:importantForAccessibility="no"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Todos los profesionales cuentan con DUI comprobado y revisión de antecedentes de El Salvador."
            android:textSize="12sp"
            android:textColor="@color/ui_primary"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
      </LinearLayout>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>

<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true">
  <!-- Ajuste trabajador: encabezados compactos y títulos de 20sp; se mantienen los IDs y las funciones. -->
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- CONTENIDO PRINCIPAL -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
      <!-- 1. CABECERA -->
      <com.google.android.material.appbar.MaterialToolbar
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@color/ui_surface"
          android:elevation="0dp"
          android:minHeight="64dp"
          app:contentInsetStart="0dp"
          app:contentInsetEnd="0dp">
        <!-- App bar Material 3; los botones de regreso conservan sus listeners. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:minHeight="64dp">
          <ImageView
              android:id="@+id/btnRegresarSolicitudesPro"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:padding="12dp"
              android:src="@drawable/ic_m3_back"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:clickable="true"
              android:focusable="true"
              android:layout_marginEnd="8dp"
              android:contentDescription="Regresar"
              android:minHeight="48dp"
              app:tint="@color/ui_text"/>
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitudes"
                android:textSize="20sp"
                android:textStyle="normal"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trabajos cerca de ti"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text_secondary"
                android:layout_marginTop="1dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <ImageView
              android:id="@+id/btnPerfilSolicitudesTop"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:background="@color/ui_brand"
              android:padding="8dp"
              android:src="@mipmap/ic_launcher"
              android:contentDescription="Perfil"
              android:minHeight="48dp"/>
        </LinearLayout>
      </com.google.android.material.appbar.MaterialToolbar>
      <!-- 2. ZONA DE TRABAJO -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="12dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="San Salvador y alrededores"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:drawableStart="@drawable/ic_m3_location"
                android:drawableTint="@color/ui_primary"
                android:drawablePadding="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radio: 5 km  ▾"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:background="@drawable/bg_m3_info"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="● GPS activo  ·  Buscando trabajos cerca de ti"
              android:textSize="12sp"
              android:textColor="@color/ui_success"
              android:layout_marginTop="7dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- 3. RESUMEN DE PROPUESTAS -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="16dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="13dp">
          <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:gravity="center"
              android:background="@drawable/bg_m3_info"
              android:layout_marginEnd="10dp"
              android:src="@drawable/ic_m3_chat"
              app:tint="@color/ui_primary"
              android:importantForAccessibility="no"/>
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 propuestas enviadas hoy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1 cliente está revisando tu perfil"
                android:textSize="12sp"
                android:textColor="@color/ui_success"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
          </LinearLayout>
          <com.google.android.material.button.MaterialButton
              android:id="@+id/btnVerPropuestasEnviadas"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Ver"
              android:textAllCaps="false"
              style="@style/Widget.Chivo.Button.Secondary"
              android:minHeight="48dp"
              android:textSize="14sp"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- 4. ENCABEZADO DEL FEED -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Trabajos disponibles"
              android:textSize="17sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Solicitudes que coinciden con tus servicios"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginTop="2dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6 disponibles"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text_secondary"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
      <!-- 5. FILTROS -->
      <HorizontalScrollView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:scrollbars="none"
          android:layout_marginBottom="16dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="36dp"
              android:gravity="center"
              android:text="Todas (6)"
              android:textSize="13sp"
              android:textStyle="bold"
              android:textColor="#FFFFFF"
              android:background="@color/ui_brand"
              android:paddingHorizontal="16dp"
              android:layout_marginEnd="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="36dp"
              android:gravity="center"
              android:text="Urgentes (3)"
              android:textSize="13sp"
              android:textStyle="bold"
              android:textColor="@color/ui_error"
              android:background="@drawable/bg_m3_error"
              android:paddingHorizontal="16dp"
              android:layout_marginEnd="8dp"
              android:drawableStart="@drawable/ic_m3_bolt"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="36dp"
              android:gravity="center"
              android:text="Fontanería"
              android:textSize="13sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text_secondary"
              android:background="@color/ui_surface"
              android:paddingHorizontal="16dp"
              android:layout_marginEnd="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="36dp"
              android:gravity="center"
              android:text="Más cercanos"
              android:textSize="13sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text_secondary"
              android:background="@color/ui_surface"
              android:paddingHorizontal="16dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
      </HorizontalScrollView>
      <!-- SOLICITUD 1 -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="14dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <!-- ETIQUETAS -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Urgente"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#EF4444"
                android:paddingHorizontal="7dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="6dp"
                android:drawableStart="@drawable/ic_m3_bolt"
                android:drawableTint="@color/ui_primary"
                android:drawablePadding="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fontanería"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:background="@drawable/bg_m3_info"
                android:paddingHorizontal="7dp"
                android:paddingVertical="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hace 6 min"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
          </LinearLayout>
          <!-- TÍTULO -->
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Fuga de agua bajo fregadero de cocina"
              android:textSize="17sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="6dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
              android:fontFamily="sans-serif-medium"/>
          <!-- DESCRIPCIÓN -->
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="El tubo de desagüe gotea constantemente y ha humedecido el mueble. Se necesita cambio de..."
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:lineSpacingExtra="2dp"
              android:layout_marginBottom="12dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <!-- FOTO -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@color/ui_background"
              android:padding="9dp"
              android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:layout_marginEnd="9dp"
                android:contentDescription="Foto adjunta"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="1 foto adjunta"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Foto del problema enviada por el cliente"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:layout_marginTop="2dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>
          </LinearLayout>
          <!-- CLIENTE -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@color/ui_brand"
                android:src="@mipmap/ic_launcher"
                android:layout_marginEnd="9dp"
                android:contentDescription="Carlos Rivera"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carlos Rivera"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:layout_marginEnd="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verificado"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_success"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"/>
              </LinearLayout>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Cumbres de Cuscatlán  •  1.2 km"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:layout_marginTop="2dp"
                  android:drawableStart="@drawable/ic_m3_location"
                  android:drawableTint="@color/ui_primary"
                  android:drawablePadding="8dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Presupuesto"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="$15 – $30"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:layout_marginTop="2dp"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
          </LinearLayout>
          <!-- BOTONES -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetallesSolicitud1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:text="Detalles"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Chivo.Button.Secondary"
                android:minHeight="48dp"
                android:textSize="14sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCotizar1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:text="Enviar cotización"
                android:textAllCaps="false"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"
                android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- SOLICITUD 2 -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="14dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <!-- ETIQUETAS -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fontanería e Hidráulica"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:background="@drawable/bg_m3_info"
                android:paddingHorizontal="7dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="6dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mañana"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:background="@drawable/bg_m3_info"
                android:paddingHorizontal="7dp"
                android:paddingVertical="4dp"
                android:drawableStart="@drawable/ic_m3_calendar"
                android:drawableTint="@color/ui_primary"
                android:drawablePadding="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hace 28 min"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
          </LinearLayout>
          <!-- TÍTULO -->
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Mantenimiento de bomba de agua y presurizador"
              android:textSize="17sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="6dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
              android:fontFamily="sans-serif-medium"/>
          <!-- DESCRIPCIÓN -->
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="La bomba residencial marca Truper no apaga automáticamente tras llenar la cisterna. Requier..."
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:lineSpacingExtra="2dp"
              android:layout_marginBottom="12dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <!-- FOTO -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@color/ui_background"
              android:padding="9dp"
              android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:layout_marginEnd="9dp"
                android:contentDescription="Placa motor"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="1 foto adjunta"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Fotografía de la placa del motor"
                  android:textSize="12sp"

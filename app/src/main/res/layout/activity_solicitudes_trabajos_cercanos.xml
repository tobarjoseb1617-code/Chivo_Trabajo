<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F7">

    <!-- CONTENEDOR PRINCIPAL SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. BARRA SUPERIOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <!-- Badge ChivoTrabajo PRO -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="14sp"
                        android:layout_marginEnd="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ChivoTrabajo"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#1F2937"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" PRO "
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="#0B2545"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="1dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="San Salvador, SV"
                            android:textSize="10sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Estado Disponible -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Disponible"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#059669"
                    android:background="#DCFCE7"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="10dp" />

                <!-- Campana -->
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input_rounded"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Notificaciones" />

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/btnPerfilSolicitudesTop"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#0B2545"
                    android:padding="8dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Perfil" />
            </LinearLayout>

            <!-- 2. BANNER DE PROPUESTAS ENVIADAS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✈️"
                        android:textSize="18sp"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2 propuestas enviadas hoy"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1 cliente revisando tu perfil"
                            android:textSize="11sp"
                            android:textColor="#059669" />
                    </LinearLayout>

                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Ver ➔"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0284C7"
                        android:backgroundTint="#E0F2FE"
                        android:paddingHorizontal="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. SUBBARRA DE ZONA Y RADIO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍  San Salvador &amp; La Li..."
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Radio: 5 km ∨"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#0284C7"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GPS activo: Recibiendo solicitudes instantáneas en Antiguo Cuscatlán, Santa Tecla y Colonia Escalón."
                        android:textSize="11sp"
                        android:textColor="#6B7280" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. FILTROS RÁPIDOS (CHIPS) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Todas (6)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#0B2545"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔴 Urgentes Hoy (3)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:background="#FFFFFF"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fontanería General"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:background="#FFFFFF"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 5. FEED DE SOLICITUDES DE TRABAJO -->

            <!-- Solicitud 1: Urgente Hoy (Fuga de agua bajo fregadero) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 🔥 ¡Emergencia Hoy! "
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#EF4444"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fontanería"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_marginEnd="6dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hace 6 min"
                            android:textSize="11sp"
                            android:textColor="#9CA3AF" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fuga de agua bajo fregadero de cocina"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="El tubo de desagüe gotea constantemente y ha humedecido el mueble. Se necesita cambio de..."
                        android:textSize="12sp"
                        android:textColor="#4B5563"
                        android:layout_marginBottom="10dp" />

                    <!-- Miniatura de foto adjunta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F8FAFC"
                        android:padding="8dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@mipmap/ic_launcher"
                            android:background="#E5E7EB"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Foto adjunta" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Foto del tubo goteando"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Adjuntada por el cliente para diagnóstico rápido"
                                android:textSize="10sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Cliente y presupuesto -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#0B2545"
                            android:src="@mipmap/ic_launcher"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Carlos Rivera" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Carlos Rivera"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" DUI "
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:background="#059669"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="1dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="📍 Cumbres de Cuscatlán • 1.2 km"
                                android:textSize="11sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Presupuesto"
                                android:textSize="9sp"
                                android:textColor="#9CA3AF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$15 – $30"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Botones de Acción -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Detalles"
                            android:textSize="12sp"
                            android:textColor="#0B2545"
                            android:backgroundTint="#E2E8F0"
                            android:layout_marginEnd="8dp"
                            android:paddingHorizontal="16dp" />

                        <Button
                            android:id="@+id/btnCotizar1"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Cotizar ($25 USD)"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#0B2545" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Solicitud 2: Mañana (Mantenimiento de bomba) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fontanería e Hidráulica"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 📅 Mañana por la mañana "
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#1E40AF"
                            android:background="#DBEAFE"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hace 28 min"
                            android:textSize="11sp"
                            android:textColor="#9CA3AF" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mantenimiento de bomba de agua y presurizador"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="La bomba residencial marca Truper no apaga automáticamente tras llenar la cisterna. Requier..."
                        android:textSize="12sp"
                        android:textColor="#4B5563"
                        android:layout_marginBottom="10dp" />

                    <!-- Miniatura de foto -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F8FAFC"
                        android:padding="8dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@mipmap/ic_launcher"
                            android:background="#E5E7EB"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Placa motor" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1 fotografía de placa de motor adjunta"
                            android:textSize="11sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>

                    <!-- Cliente y presupuesto -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#0B2545"
                            android:src="@mipmap/ic_launcher"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Mariana Palacios" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mariana Palacios"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" DUI "
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:background="#059669"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="1dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="📍 Colonia Escalón • 2.4 km"
                                android:textSize="11sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mano de obra"
                                android:textSize="9sp"
                                android:textColor="#9CA3AF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$40 – $70"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Botón Enviar Oferta -->
                    <Button
                        android:id="@+id/btnEnviarOferta2"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="💬 Enviar Oferta Personalizada"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:backgroundTint="#E2E8F0" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Solicitud 3: Flexible (Cambio de mezcladoras) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instalaciones"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 📅 Esta semana (Flexible) "
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#4B5563"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hace 1 h"
                            android:textSize="11sp"
                            android:textColor="#9CA3AF" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cambio de 3 mezcladoras de lavamanos y llaves angulares"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="4dp" />

                    <TextView

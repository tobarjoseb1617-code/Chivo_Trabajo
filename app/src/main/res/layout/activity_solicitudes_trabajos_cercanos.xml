<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F7"
    android:fitsSystemWindows="true">

    <!-- CONTENIDO PRINCIPAL -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- 1. CABECERA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/btnRegresarSolicitudesPro"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Regresar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solicitudes cercanas"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ChivoTrabajo PRO"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Disponible"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#059669"
                    android:background="#DCFCE7"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/btnPerfilSolicitudesTop"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#0B2545"
                    android:padding="8dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Perfil" />

            </LinearLayout>



            <!-- 2. ZONA DE TRABAJO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📍 San Salvador y alrededores"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Radio: 5 km  ▾"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="5dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="● GPS activo  ·  Buscando trabajos cerca de ti"
                        android:textSize="10sp"
                        android:textColor="#059669"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- 3. RESUMEN DE PROPUESTAS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="📨"
                        android:textSize="17sp"
                        android:background="#E0F2FE"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2 propuestas enviadas hoy"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1 cliente está revisando tu perfil"
                            android:textSize="10sp"
                            android:textColor="#059669"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnVerPropuestasEnviadas"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Ver"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0369A1"
                        android:backgroundTint="#E0F2FE"
                        android:paddingHorizontal="14dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- 4. ENCABEZADO DEL FEED -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trabajos disponibles"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solicitudes que coinciden con tus servicios"
                        android:textSize="10sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6 disponibles"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#64748B" />

            </LinearLayout>


            <!-- 5. FILTROS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="Todas (6)"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#0B2545"
                        android:paddingHorizontal="14dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="🔥 Urgentes (3)"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#B91C1C"
                        android:background="#FEE2E2"
                        android:paddingHorizontal="14dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="Fontanería"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#475569"
                        android:background="#FFFFFF"
                        android:paddingHorizontal="14dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="Más cercanos"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#475569"
                        android:background="#FFFFFF"
                        android:paddingHorizontal="14dp" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- SOLICITUD 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <!-- ETIQUETAS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 URGENTE"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#EF4444"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fontanería"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="4dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hace 6 min"
                            android:textSize="10sp"
                            android:textColor="#94A3B8" />

                    </LinearLayout>


                    <!-- TÍTULO -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fuga de agua bajo fregadero de cocina"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="6dp" />


                    <!-- DESCRIPCIÓN -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="El tubo de desagüe gotea constantemente y ha humedecido el mueble. Se necesita cambio de..."
                        android:textSize="12sp"
                        android:textColor="#4B5563"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="12dp" />


                    <!-- FOTO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F8FAFC"
                        android:padding="9dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@mipmap/ic_launcher"
                            android:background="#E5E7EB"
                            android:layout_marginEnd="9dp"
                            android:contentDescription="Foto adjunta" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="1 foto adjunta"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Foto del problema enviada por el cliente"
                                android:textSize="10sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- CLIENTE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="#0B2545"
                            android:src="@mipmap/ic_launcher"
                            android:layout_marginEnd="9dp"
                            android:contentDescription="Carlos Rivera" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Carlos Rivera"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="✓ Verificado"
                                    android:textSize="8sp"
                                    android:textStyle="bold"
                                    android:textColor="#059669" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="📍 Cumbres de Cuscatlán  •  1.2 km"
                                android:textSize="10sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PRESUPUESTO"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:textColor="#94A3B8" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$15 – $30"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- BOTONES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnDetallesSolicitud1"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="0.7"
                            android:text="Detalles"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#475569"
                            android:backgroundTint="#E2E8F0"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btnCotizar1"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1.3"
                            android:text="Enviar cotización"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#0B2545" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- SOLICITUD 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <!-- ETIQUETAS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fontanería e Hidráulica"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅 Mañana"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#1E40AF"
                            android:background="#DBEAFE"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="4dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hace 28 min"
                            android:textSize="10sp"
                            android:textColor="#94A3B8" />

                    </LinearLayout>


                    <!-- TÍTULO -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mantenimiento de bomba de agua y presurizador"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="6dp" />


                    <!-- DESCRIPCIÓN -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="La bomba residencial marca Truper no apaga automáticamente tras llenar la cisterna. Requier..."
                        android:textSize="12sp"
                        android:textColor="#4B5563"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="12dp" />


                    <!-- FOTO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F8FAFC"
                        android:padding="9dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@mipmap/ic_launcher"
                            android:background="#E5E7EB"
                            android:layout_marginEnd="9dp"
                            android:contentDescription="Placa motor" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="1 foto adjunta"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fotografía de la placa del motor"
                                android:textSize="10sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- CLIENTE Y PRECIO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="#0B2545"
                            android:src="@mipmap/ic_launcher"
                            android:layout_marginEnd="9dp"
                            android:contentDescription="Mariana Palacios" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mariana Palacios"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="✓ Verificado"
                                    android:textSize="8sp"
                                    android:textStyle="bold"
                                    android:textColor="#059669" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="📍 Colonia Escalón  •  2.4 km"
                                android:textSize="10sp"
                                android:textColor="#64748B"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PRESUPUESTO"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:textColor="#94A3B8" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$40 – $70"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- BOTÓN -->
                    <Button
                        android:id="@+id/btnEnviarOferta2"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="Enviar propuesta"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#0B2545" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- SOLICITUD 3 -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">


                    <!-- ETIQUETAS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instalaciones"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="4dp"

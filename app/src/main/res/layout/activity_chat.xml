<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ui_background" android:fitsSystemWindows="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical" android:background="@color/ui_surface">
  <ImageButton android:id="@+id/btnRegresarChat" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_m3_back" android:contentDescription="Regresar" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/ui_text"/>
  <TextView android:id="@+id/tvNombreContacto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Conversación" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/ui_text"/>
 </LinearLayout>
 <TextView android:id="@+id/tvChatVacio" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Envía un mensaje para iniciar la conversación" android:textColor="@color/ui_text_secondary" android:gravity="center"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/listaMensajes" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" android:clipToPadding="false"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/btnReintentarAdjunto" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reintentar envío del archivo" android:visibility="gone" style="@style/Widget.Chivo.Button.Secondary"/>
 <ProgressBar android:id="@+id/progresoEnvio" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone"/>
 <TextView android:id="@+id/tvEstadoGrabacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="Grabando (máximo 2 minutos). Pulsa Enviar voz para terminar." android:textColor="@color/ui_text" android:visibility="gone"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:gravity="center_vertical" android:background="@color/ui_surface">
  <EditText android:id="@+id/etMensajeChat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Escribe un mensaje" android:inputType="textCapSentences|textMultiLine" android:maxLength="4000" android:maxLines="4" android:minHeight="48dp" android:background="@drawable/bg_input_rounded" android:padding="12dp" android:textColor="@color/ui_text" android:textColorHint="@color/ui_text_secondary"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/btnEnviarMensaje" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enviar" style="@style/Widget.Chivo.Button"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:background="@color/ui_surface">
  <com.google.android.material.button.MaterialButton android:id="@+id/btnAdjuntar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adjuntar" style="@style/Widget.Chivo.Button.Secondary"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/btnGrabar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Voz" style="@style/Widget.Chivo.Button.Secondary"/>
 </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F7">

    <!-- 1. BARRA SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnRegresarChat"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_marginEnd="12dp"
            android:contentDescription="Regresar" />

        <!-- Badge Logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat Detalle"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0B2545" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="#0B2545"
            android:padding="8dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Perfil" />
    </LinearLayout>

    <!-- 2. CABECERA DEL CONTACTO (ROBERTO MÉNDEZ) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <RelativeLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_launcher"
                    android:background="#E5E7EB"
                    android:contentDescription="Roberto Méndez" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:background="#059669" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Roberto Méndez"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0B2545" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" DUI Verificado "
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#059669"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• En línea"
                        android:textSize="11sp"
                        android:textColor="#059669" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="📞"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/bg_input_rounded"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="⋮"
                android:textSize="18sp"
                android:gravity="center"
                android:background="@drawable/bg_input_rounded" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. CUERPO DE MENSAJES (SCROLLABLE) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TARJETA FIJADA: ACUERDO LEGAL CHIVO (PROPUESTA DE SERVICIO) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ ACUERDO LEGAL CHIVO"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" Confirmado "
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#0284C7"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Propuesta de Servicio ..."
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🛠️ Reparación de fuga bajo fregadero..."
                        android:textSize="12sp"
                        android:textColor="#4B5563"
                        android:layout_marginBottom="10dp" />

                    <!-- Fila de Detalles: Precio y Llegada -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F8FAFC"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Precio fijado"
                                android:textSize="10sp"
                                android:textColor="#9CA3AF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$25.00 USD"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mano de obra y garantía"
                                android:textSize="9sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F8FAFC"
                            android:padding="10dp"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Llegada estimada"
                                android:textSize="10sp"
                                android:textColor="#9CA3AF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2:30 PM"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="En 20 minutos"
                                android:textSize="9sp"
                                android:textColor="#059669"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 Residencial Cumbres de Cuscatlán, Casa #14"
                        android:textSize="11sp"
                        android:textColor="#4B5563"
                        android:layout_marginBottom="10dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginBottom="10dp" />

                    <!-- Footer de la tarjeta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🛡️ Fondos protegidos en garantía"
                            android:textSize="11sp"
                            android:textColor="#059669"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ver detalles ➔"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0284C7" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TIMESTAMP: Hoy, 2:10 PM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Hoy, 2:10 PM"
                android:textSize="10sp"
                android:textColor="#9CA3AF"
                android:background="#E5E7EB"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginBottom="14dp" />

            <!-- Mensaje 1 (Entrante - Roberto) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@mipmap/ic_launcher"
                    android:background="#E5E7EB"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="bottom"
                    android:contentDescription="Roberto" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_input_rounded"
                    android:padding="10dp"
                    android:maxWidth="260dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Roberto Méndez"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buenas tardes, vi la foto de la fuga..."
                        android:textSize="13sp"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="2:12 PM"
                        android:textSize="9sp"
                        android:textColor="#9CA3AF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mensaje 2 (Saliente - Usuario) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#0B2545"
                    android:padding="10dp"
                    android:maxWidth="260dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Hola! ¿Cuánto tardaría en llegar?..."
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="2:14 PM ✔️✔️"
                        android:textSize="9sp"
                        android:textColor="#93C5FD" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mensaje 3 (Entrante - Roberto) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@mipmap/ic_launcher"
                    android:background="#E5E7EB"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="bottom"
                    android:contentDescription="Roberto" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_input_rounded"
                    android:padding="10dp"
                    android:maxWidth="260dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Roberto Méndez"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En Santa Tecla, llego en 15 min..."
                        android:textSize="13sp"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="2:15 PM"
                        android:textSize="9sp"
                        android:textColor="#9CA3AF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mensaje 4 (Saliente - Usuario) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#0B2545"
                    android:padding="10dp"
                    android:maxWidth="260dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="De acuerdo, propuesta aceptada..."
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="2:18 PM ✔️✔️"
                        android:textSize="9sp"
                        android:textColor="#93C5FD" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tarjeta de Sistema: Acuerdo confirmado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#DCFCE7"
                android:padding="10dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✈️"
                    android:textSize="18sp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Acuerdo confirmado"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#166534" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Roberto va en trayecto..."
                        android:textSize="11sp"
                        android:textColor="#15803D" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2:19 PM"
                    android:textSize="9sp"
                    android:textColor="#166534" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 4. BARRA INFERIOR DE ENTRADA DE MENSAJES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="12dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:textSize="20sp"
            android:gravity="center"
            android:textColor="#4B5563"
            android:background="@drawable/bg_input_rounded"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etMensajeChat"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_rounded"
            android:hint="Escribe un mensaje a Roberto..."
            android:textSize="13sp"
            android:paddingHorizontal="14dp"
            android:inputType="text"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="🎤"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnEnviarMensaje"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="➤"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B2545"
            android:padding="0dp" />
    </LinearLayout>

</LinearLayout>

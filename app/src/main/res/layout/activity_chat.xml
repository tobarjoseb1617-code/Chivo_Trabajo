<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- 1. BARRA SUPERIOR -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:padding="16dp"
      android:background="@color/ui_surface"
      android:elevation="2dp">
    <ImageView
        android:id="@+id/btnRegresarChat"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_m3_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginEnd="8dp"
        android:contentDescription="Regresar"
        android:minHeight="48dp"
        app:tint="@color/ui_text"/>
    <!-- Badge Logo -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input_rounded"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:layout_marginEnd="8dp">
      <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="4dp"
          android:src="@drawable/ic_m3_shield"
          app:tint="@color/ui_primary"
          android:importantForAccessibility="no"/>
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Chat Detalle"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@color/ui_brand"
        android:padding="8dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Perfil"/>
  </LinearLayout>
  <!-- 2. CABECERA DEL CONTACTO (ROBERTO MÉNDEZ) -->
  <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:cardBackgroundColor="@color/ui_surface"
      android:layout_marginBottom="12dp"
      style="@style/Widget.Chivo.Card">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">
      <RelativeLayout
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_marginEnd="12dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_launcher"
            android:background="@color/ui_outline"
            android:contentDescription="Roberto Méndez"/>
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:background="#059669"/>
      </RelativeLayout>
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Roberto Méndez"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="DUI Verificado"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="#FFFFFF"
              android:background="#059669"
              android:paddingHorizontal="4dp"
              android:paddingVertical="1dp"
              android:layout_marginEnd="6dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="• En línea"
              android:textSize="12sp"
              android:textColor="@color/ui_success"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
      </LinearLayout>
      <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:gravity="center"
          android:background="@drawable/bg_input_rounded"
          android:layout_marginEnd="8dp"
          android:src="@drawable/ic_m3_phone"
          app:tint="@color/ui_primary"
          android:importantForAccessibility="no"/>
      <TextView
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:text="⋮"
          android:textSize="18sp"
          android:gravity="center"
          android:background="@drawable/bg_input_rounded"
          android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
          android:fontFamily="sans-serif"
          android:lineSpacingExtra="2sp"/>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <!-- 3. CUERPO DE MENSAJES (SCROLLABLE) -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:paddingHorizontal="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
      <!-- TARJETA FIJADA: ACUERDO LEGAL CHIVO (PROPUESTA DE SERVICIO) -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="16dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acuerdo legal chivo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:drawableStart="@drawable/ic_m3_shield"
                android:drawableTint="@color/ui_primary"
                android:drawablePadding="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmado"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:background="@drawable/bg_m3_info"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Propuesta de Servicio ..."
              android:textSize="16sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="4dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Reparación de fuga bajo fregadero..."
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="10dp"
              android:drawableStart="@drawable/ic_m3_build"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <!-- Fila de Detalles: Precio y Llegada -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:layout_marginBottom="10dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@color/ui_background"
                android:padding="10dp"
                android:layout_marginEnd="6dp">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Precio fijado"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="$25.00 usd"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Mano de obra y garantía"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@color/ui_background"
                android:padding="10dp"
                android:layout_marginStart="6dp">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Llegada estimada"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="2:30 pm"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="En 20 minutos"
                  android:textSize="14sp"
                  android:textColor="@color/ui_success"
                  android:textStyle="bold"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Residencial Cumbres de Cuscatlán, Casa #14"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="10dp"
              android:drawableStart="@drawable/ic_m3_location"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:background="@color/ui_outline"
              android:layout_marginBottom="10dp"/>
          <!-- Footer de la tarjeta -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fondos protegidos en garantía"
                android:textSize="14sp"
                android:textColor="@color/ui_success"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_m3_shield"
                android:drawableTint="@color/ui_primary"
                android:drawablePadding="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver detalles"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- TIMESTAMP: Hoy, 2:10 PM -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:text="Hoy, 2:10 PM"
          android:textSize="12sp"
          android:textColor="@color/ui_text_secondary"
          android:background="@color/ui_outline"
          android:paddingHorizontal="10dp"
          android:paddingVertical="3dp"
          android:layout_marginBottom="14dp"
          android:textAppearance="@style/TextAppearance.Material3.BodySmall"
          android:fontFamily="sans-serif"/>
      <!-- Mensaje 1 (Entrante - Roberto) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="start"
          android:layout_marginBottom="12dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher"
            android:background="@color/ui_outline"
            android:layout_marginEnd="8dp"
            android:layout_gravity="bottom"
            android:contentDescription="Roberto"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_rounded"
            android:padding="10dp"
            android:maxWidth="260dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Roberto Méndez"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="2dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Buenas tardes, vi la foto de la fuga..."
              android:textSize="14sp"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="2dp"
              android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="2sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="end"
              android:text="2:12 pm"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
      </LinearLayout>
      <!-- Mensaje 2 (Saliente - Usuario) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="end"
          android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/ui_brand"
            android:padding="10dp"
            android:maxWidth="260dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="¡Hola! ¿Cuánto tardaría en llegar?..."
              android:textSize="14sp"
              android:textColor="#FFFFFF"
              android:layout_marginBottom="2dp"
              android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="2sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="end"
              android:text="2:14 pm"
              android:textSize="12sp"
              android:textColor="#93C5FD"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
      </LinearLayout>
      <!-- Mensaje 3 (Entrante - Roberto) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="start"
          android:layout_marginBottom="12dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher"
            android:background="@color/ui_outline"
            android:layout_marginEnd="8dp"
            android:layout_gravity="bottom"
            android:contentDescription="Roberto"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_input_rounded"
            android:padding="10dp"
            android:maxWidth="260dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Roberto Méndez"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="2dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="En Santa Tecla, llego en 15 min..."
              android:textSize="14sp"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="2dp"
              android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="2sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="end"
              android:text="2:15 pm"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
      </LinearLayout>
      <!-- Mensaje 4 (Saliente - Usuario) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="end"
          android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/ui_brand"
            android:padding="10dp"
            android:maxWidth="260dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="De acuerdo, propuesta aceptada..."
              android:textSize="14sp"
              android:textColor="#FFFFFF"
              android:layout_marginBottom="2dp"
              android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="2sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="end"
              android:text="2:18 pm"
              android:textSize="12sp"
              android:textColor="#93C5FD"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
      </LinearLayout>
      <!-- Tarjeta de Sistema: Acuerdo confirmado -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/bg_m3_success"
          android:padding="10dp"
          android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✈️"
            android:textSize="18sp"
            android:layout_marginEnd="8dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2sp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Acuerdo confirmado"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_success"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Roberto va en trayecto..."
              android:textSize="12sp"
              android:textColor="@color/ui_success"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2:19 pm"
            android:textSize="12sp"
            android:textColor="@color/ui_success"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <!-- 4. BARRA INFERIOR DE ENTRADA DE MENSAJES -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:background="@color/ui_surface"
      android:elevation="8dp"
      android:padding="12dp">
    <TextView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="+"
        android:textSize="22sp"
        android:gravity="center"
        android:textColor="@color/ui_text_secondary"
        android:background="@drawable/bg_input_rounded"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:fontFamily="sans-serif-medium"/>
    <EditText
        android:id="@+id/etMensajeChat"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/bg_input_rounded"
        android:hint="Escribe un mensaje a Roberto..."
        android:textSize="16sp"
        android:paddingHorizontal="16dp"
        android:inputType="text"
        android:layout_marginEnd="8dp"
        android:minHeight="48dp"/>
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_m3_microphone"
        app:tint="@color/ui_primary"
        android:importantForAccessibility="no"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnviarMensaje"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:text="➤"
        android:padding="0dp"
        style="@style/Widget.Chivo.Button"
        android:minHeight="48dp"/>
  </LinearLayout>
</LinearLayout>

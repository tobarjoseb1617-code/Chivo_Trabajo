<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F5F7"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- FORMULARIO PRINCIPAL -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ENCABEZADO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nueva solicitud"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PASO 2 DE 5"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0369A1"
                                android:layout_marginBottom="5dp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:background="#0284C7" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detalles del trabajo"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#6B7280"
                            android:layout_marginStart="14dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 1. SERVICIO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. SERVICIO"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="7dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛠️"
                            android:textSize="20sp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Categoría de servicio"
                                android:textSize="10sp"
                                android:textColor="#9CA3AF" />

                            <TextView
                                android:id="@+id/tvCategoriaServicio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Selecciona una categoría"
                                android:textSize="15sp"
                                android:textColor="#6B7280" />

                        </LinearLayout>

                        <Button
                            android:id="@+id/btnCambiarCategoria"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Seleccionar"
                            android:textSize="11sp"
                            android:textColor="#0B2545"
                            android:backgroundTint="#E2E8F0"
                            android:paddingHorizontal="10dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 2. DESCRIPCIÓN DEL PROBLEMA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="7dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2. DESCRIBE EL PROBLEMA"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Requerido"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#059669" />

                </LinearLayout>

                <EditText
                    android:id="@+id/etDetallesSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="105dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Cuéntanos qué problema tienes..."
                    android:textSize="13sp"
                    android:padding="12dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:maxLength="300"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tvContadorCaracteres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 / 300 caracteres"
                    android:textSize="10sp"
                    android:textColor="#9CA3AF"
                    android:gravity="end"
                    android:layout_marginBottom="20dp" />

                <!-- 3. FOTOGRAFÍAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="7dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3. FOTOGRAFÍAS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opcional · Recomendado"
                        android:textSize="10sp"
                        android:textColor="#0284C7" />

                </LinearLayout>

                <!-- Galería -->
                <LinearLayout
                    android:id="@+id/layoutGaleriaFotos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <!-- Agregar foto -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnAgregarFoto"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#F8FAFC"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📷"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agregar"
                                android:textSize="10sp"
                                android:textColor="#0284C7"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Límite -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F1F5F9">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🖼️"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hasta 5 fotos"
                                android:textSize="8sp"
                                android:textColor="#9CA3AF"
                                android:gravity="center" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Las fotos ayudan al profesional a conocer mejor el problema."
                    android:textSize="10sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginBottom="20dp" />

                <!-- 4. UBICACIÓN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="7dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4. UBICACIÓN"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:id="@+id/tvEditarUbicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#0284C7" />

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="7dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📍"
                                android:textSize="16sp"
                                android:layout_marginEnd="8dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDireccionUbicacion"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Seleccionar ubicación"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#6B7280" />

                                <TextView
                                    android:id="@+id/tvDetalleUbicacion"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Aquí aparecerá la dirección seleccionada"
                                    android:textSize="10sp"
                                    android:textColor="#9CA3AF" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Mini mapa -->
                        <RelativeLayout
                            android:id="@+id/miniMapa"
                            android:layout_width="match_parent"
                            android:layout_height="75dp"
                            android:background="#E5E7EB">

                            <TextView
                                android:id="@+id/tvTextoMapa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="Selecciona una ubicación"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#4B5563" />

                            <TextView
                                android:id="@+id/tvMarcadorMapa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:textColor="#FFFFFF"
                                android:text=" 📍 "
                                android:textSize="10sp"
                                android:visibility="gone" />

                        </RelativeLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 5. FECHA Y HORA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. FECHA Y HORA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="8dp" />

                <!-- Opción 1 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardLoAntesPosible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="7dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡"
                            android:textSize="18sp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLoAntesPosible"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Lo antes posible"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#1F2937" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Solicitar atención lo antes posible"
                                android:textSize="10sp"
                                android:textColor="#6B7280" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Opción 2 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardManana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="7dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅"
                            android:textSize="18sp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Mañana"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#1F2937" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Durante la mañana o tarde"
                                android:textSize="10sp"
                                android:textColor="#6B7280" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Opción 3 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardProgramarFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📆"
                            android:textSize="18sp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Elegir fecha y hora"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#1F2937" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Escoge día y franja horaria"
                                android:textSize="10sp"
                                android:textColor="#6B7280" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 6. PRESUPUESTO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="7dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="6. PRESUPUESTO"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USD ($)"
                        android:textSize="10sp"
                        android:textColor="#6B7280" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selecciona un rango aproximado para tu trabajo"
                    android:textSize="10sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="7dp" />

                <!-- Presupuestos -->
                <LinearLayout
                    android:id="@+id/layoutPresupuestos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp">

                    <!-- Presupuesto 1 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPresupuesto15_30"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardCornerRadius="9dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#F8FAFC">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="9dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RANGO 1"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:textColor="#6B7280" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$15 – $30"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Presupuesto aproximado"
                                android:textSize="8sp"
                                android:textColor="#4B5563" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Presupuesto 2 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPresupuesto30_50"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        app:cardCornerRadius="9dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#F8FAFC">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="9dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RANGO 2"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:textColor="#6B7280" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$30 – $50"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Presupuesto aproximado"
                                android:textSize="8sp"
                                android:textColor="#4B5563" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Presupuesto 3 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPresupuestoConvenir"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="9dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#F8FAFC">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="9dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FLEXIBLE"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:textColor="#6B7280" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="A convenir"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Según revisión"
                                android:textSize="8sp"
                                android:textColor="#4B5563" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ Los profesionales enviarán sus ofertas basadas en este rango."
                    android:textSize="10sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginBottom="18dp" />

                <!-- 7. GARANTÍA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#DCFCE7"
                    android:padding="11dp"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="19sp"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Garantía ChivoSeguro"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#166534" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

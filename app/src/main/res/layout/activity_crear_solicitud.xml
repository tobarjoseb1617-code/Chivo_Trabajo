<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Tarjeta Blanca Central -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 1. BARRA DE PROGRESO: PASO 2 DE 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PASO 2 DE 5"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="#0284C7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detalles del trabajo"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#6B7280"
                        android:layout_marginStart="16dp" />
                </LinearLayout>

                <!-- 2. CATEGORÍA DE SERVICIO -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛠️"
                            android:textSize="20sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Categoría de servicio"
                                android:textSize="10sp"
                                android:textColor="#9CA3AF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fontanería y Tuberías"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />
                        </LinearLayout>

                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Cambiar"
                            android:textSize="12sp"
                            android:textColor="#0B2545"
                            android:backgroundTint="#E2E8F0"
                            android:paddingHorizontal="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. CUÉNTANOS QUÉ SUCEDE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cuéntanos qué sucede"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ ¡Detallado!"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#059669" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etDetallesSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Fuga de agua debajo del fregadero de la cocina. El tubo de desagüe gotea constantemente y ha humedecido el mueble..."
                    android:textSize="13sp"
                    android:padding="12dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="158 caracteres"
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"
                    android:gravity="end"
                    android:layout_marginBottom="20dp" />

                <!-- 4. FOTOGRAFÍAS DEL PROBLEMA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fotografías del problema"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recomendado"
                        android:textSize="11sp"
                        android:textColor="#0284C7" />
                </LinearLayout>

                <!-- Galería de fotos simulada -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <!-- Foto 1 con botón eliminar -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="1dp"
                        android:layout_marginEnd="8dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@mipmap/ic_launcher"
                                android:background="#E5E7EB"
                                android:contentDescription="Foto 1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:background="#1F2937"
                                android:text="Foto 1"
                                android:textSize="9sp"
                                android:textColor="#FFFFFF"
                                android:paddingHorizontal="4dp" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Botón Agregar -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#F8FAFC"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📷"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agregar"
                                android:textSize="10sp"
                                android:textColor="#0284C7"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Placeholder hasta 5 fotos -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F1F5F9">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🖼️"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hasta 5 fotos"
                                android:textSize="9sp"
                                android:textColor="#9CA3AF"
                                android:gravity="center" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Subir fotos claras ayuda a los fontaneros certificados con DUI a cotizar repuestos exactos sin cargos sorpresa."
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginBottom="20dp" />

                <!-- 5. UBICACIÓN CONFIRMADA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ubicación confirmada"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Editar"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0284C7" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📍"
                                android:textSize="16sp"
                                android:layout_marginEnd="8dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Residencial Cumbres de Cuscatlán"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Polígono D, Casa #14, Antiguo Cuscatlán\n🏳️ Frente al parque principal, portón negro"
                                    android:textSize="11sp"
                                    android:textColor="#4B5563" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Mini Mapa -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:background="#E5E7EB">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="🗺️ [Antiguo Cuscatlán, SV]"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#4B5563" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:background="#0B2545"
                                android:textColor="#FFFFFF"
                                android:text=" 📍 "
                                android:textSize="11sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 6. ¿PARA CUÁNDO LO NECESITAS? -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Para cuándo lo necesitas?"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="8dp" />

                <!-- Opción 1: Lo antes posible (Seleccionada) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#0B2545"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡"
                            android:textSize="18sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="¡Lo antes posible (Hoy)!"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Atención inmediata a emergencias"
                                android:textSize="11sp"
                                android:textColor="#93C5FD" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="#059669"
                            android:textColor="#FFFFFF"
                            android:text=" ✓ "
                            android:textSize="12sp"
                            android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Opción 2: Mañana -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅"
                            android:textSize="18sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Mañana"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#1F2937" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Durante la mañana o tarde"
                                android:textSize="11sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Opción 3: Programar fecha -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📆"
                            android:textSize="18sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Programar fecha"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#1F2937" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Escoge día y franja horaria"
                                android:textSize="11sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 7. PRESUPUESTO ESTIMADO DEL TRABAJO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Presupuesto estimado del trabajo"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Moneda: USD ($)"
                        android:textSize="11sp"
                        android:textColor="#6B7280" />
                </LinearLayout>

                <!-- Tarjetas de Presupuesto (3 columnas simuladas) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <!-- Presupuesto 1 (Seleccionado) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#E0F2FE">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IDEAL FUGAS"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="#0369A1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$15 – $30"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mano de obra"
                                android:textSize="9sp"
                                android:textColor="#4B5563" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Presupuesto 2 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#F8FAFC">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COMPLETO"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="#6B7280" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$30 – $50"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+ Repuestos"
                                android:textSize="9sp"
                                android:textColor="#4B5563" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Presupuesto 3 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#F8FAFC">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FLEXIBLE"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="#6B7280" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="A convenir"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Según revisión"
                                android:textSize="9sp"
                                android:textColor="#4B5563" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ℹ️  Los fontaneros enviarán sus ofertas basadas en este rango."
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginBottom="20dp" />

                <!-- 8. GARANTÍA CHIVOSEGURO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#DCFCE7"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Garantía ChivoSeguro"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#166534" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Profesionales auditados con Solvencia Policial y DUI vigente."
                            android:textSize="11sp"
                            android:textColor="#15803D" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 9. BOTÓN PRINCIPAL: PUBLICAR SOLICITUD -->
                <Button
                    android:id="@+id/btnPublicarSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Publicar Solicitud de Fontanería ➔"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0B2545"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Footer: Tiempo de respuesta promedio -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏱️ Respuesta promedio en Santa Tecla y Antiguo Cuscatlán: 7 min"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#9CA3AF"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="16dp" />

    </LinearLayout>
</ScrollView>

<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:background="@color/ui_background">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp"
      android:gravity="center_horizontal">
    <!-- Tarjeta Blanca Central -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/ui_surface"
        style="@style/Widget.Chivo.Card">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="24dp">
        <!-- 1. BARRA SUPERIOR MOCKUP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
          <ImageView
              android:id="@+id/btnRegresarRegistroPaso2"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:src="@drawable/ic_m3_back"
              android:layout_marginEnd="12dp"
              android:contentDescription="Regresar"
              android:minHeight="48dp"
              android:background="?attr/selectableItemBackground"
              app:tint="@color/ui_text"
              android:padding="12dp"/>
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chivotrabajo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registro Cliente Paso 2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <ImageView
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:background="@color/ui_brand"
              android:padding="8dp"
              android:src="@mipmap/ic_launcher"
              android:contentDescription="Perfil"/>
        </LinearLayout>
        <!-- 2. BARRA DE PROGRESO: PASO 2 DE 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASO 2 DE 2 • Final"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:layout_marginBottom="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="#0284C7"/>
          </LinearLayout>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="100%"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginStart="16dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <!-- 3. TÍTULO Y SUBTÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dirección y Ubicación"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ayuda a que los profesionales cercanos puedan estimar tiempos de llegada exactos."
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:layout_marginBottom="16dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
        <!-- 4. VISTA PREVIA DE MAPA LEAFLET -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            app:cardBackgroundColor="@color/ui_outline"
            android:layout_marginBottom="20dp"
            style="@style/Widget.Chivo.Card">
          <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <WebView
                android:id="@+id/webViewMapa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <!-- Badge Lat, Lng -->
            <TextView
                android:id="@+id/tvCoordenadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_margin="10dp"
                android:background="@color/ui_surface"
                android:text="Lat: 13.6894, Lng: -89.2361"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_success"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:elevation="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
        <!-- 5. MUNICIPIO / DEPARTAMENTO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Municipio / Departamento"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_rounded"
            android:layout_marginBottom="16dp">
          <EditText
              android:id="@+id/etMunicipio"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@null"
              android:hint="San Salvador Centro"
              android:textSize="16sp"
              android:textColorHint="@color/ui_text_secondary"
              android:paddingHorizontal="12dp"
              android:inputType="text"
              android:minHeight="48dp"/>
        </RelativeLayout>
        <!-- 6. DIRECCIÓN EXACTA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dirección exacta"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Chivo.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Calle, Colonia, Polígono, Casa o Apto # (Ej. Col. Escalón, Pje. 3, #14)">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etDireccionExacta"
              android:textSize="16sp"
              android:textColor="@color/ui_text"
              android:paddingHorizontal="12dp"
              android:inputType="textPostalAddress"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="56dp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <!-- 7. PUNTO DE REFERENCIA (Opcional) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Punto de referencia"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Opcional"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Chivo.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Ej. Frente al parque, casa de portón negro">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etPuntoReferencia"
              android:textSize="16sp"
              android:textColor="@color/ui_text"
              android:paddingHorizontal="12dp"
              android:inputType="text"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="56dp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <!-- 8. TARJETA DE PRIVACIDAD DE DIRECCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_m3_info"
            android:padding="12dp"
            android:layout_marginBottom="20dp">
          <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_marginEnd="10dp"
              android:src="@drawable/ic_m3_shield"
              app:tint="@color/ui_primary"
              android:importantForAccessibility="no"/>
          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Tu dirección exacta solo se comparte con el profesional una vez confirmes y aceptes un servicio."
              android:textSize="12sp"
              android:textColor="@color/ui_primary"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
        <!-- 9. BOTÓN PRINCIPAL: COMPLETAR REGISTRO Y EXPLORAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompletarRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completar Registro y Explorar"
            android:layout_marginBottom="8dp"
            style="@style/Widget.Chivo.Button"
            android:minHeight="48dp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Pie de página: Configurar más tarde -->
    <TextView
        android:id="@+id/btnOmitirDireccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configurar más tarde"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/ui_text"
        android:layout_marginBottom="20dp"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:fontFamily="sans-serif-medium"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"/>
  </LinearLayout>
</ScrollView>

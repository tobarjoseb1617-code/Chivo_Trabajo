<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- ============================== -->
  <!-- BARRA SUPERIOR                 -->
  <!-- ============================== -->
  <LinearLayout
      android:id="@+id/layoutHeaderPortafolio"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:minHeight="64dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:background="@color/ui_surface"
      android:elevation="2dp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">
    <ImageView
        android:id="@+id/btnRegresarPortafolio"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:src="@drawable/ic_m3_back"
        android:contentDescription="Regresar"
        android:minHeight="48dp"
        android:background="?attr/selectableItemBackground"
        app:tint="@color/ui_text"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:text="Mi Portafolio"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/ui_text"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRO"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@color/ui_brand"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:fontFamily="sans-serif-medium"/>
  </LinearLayout>
  <!-- ============================== -->
  <!-- CONTENIDO                      -->
  <!-- ============================== -->
  <LinearLayout
      android:id="@+id/layoutContenidoPortafolio"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:orientation="vertical"
      android:padding="16dp"
      app:layout_constraintTop_toBottomOf="@id/layoutHeaderPortafolio"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">
    <!-- PRESENTACIÓN -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="@color/ui_surface"
        style="@style/Widget.Chivo.Card">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Muestra tus mejores trabajos"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:layout_marginBottom="6dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agrega fotografías de trabajos que hayas realizado para que los clientes conozcan tu experiencia."
            android:textSize="14sp"
            android:textColor="@color/ui_text_secondary"
            android:lineSpacingExtra="2sp"
            android:layout_marginBottom="18dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:fontFamily="sans-serif"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarTrabajo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+  Agregar trabajo"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp"
            style="@style/Widget.Chivo.Button"
            android:minHeight="48dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarTituloPortafolio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+  Agregar título / Acreditación"
            android:textAllCaps="false"
            style="@style/Widget.Chivo.Button"
            android:minHeight="48dp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- TÍTULO DE LA LISTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Trabajos publicados"
          android:textSize="17sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
          android:fontFamily="sans-serif-medium"/>
      <TextView
          android:id="@+id/tvCantidadTrabajos"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="0"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:background="@color/ui_outline"
          android:paddingStart="10dp"
          android:paddingEnd="10dp"
          android:paddingTop="5dp"
          android:paddingBottom="5dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <!-- ============================== -->
    <!-- ESTADO VACÍO                   -->
    <!-- Se muestra cuando no hay fotos -->
    <!-- ============================== -->
    <LinearLayout
        android:id="@+id/layoutPortafolioVacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">
      <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginBottom="14dp"
          android:src="@drawable/ic_m3_image"
          app:tint="@color/ui_primary"
          android:importantForAccessibility="no"/>
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Aún no tienes trabajos publicados"
          android:textSize="17sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:gravity="center"
          android:layout_marginBottom="8dp"
          android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
          android:fontFamily="sans-serif-medium"/>
      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Agrega tu primer trabajo para mostrar tu experiencia a los clientes."
          android:textSize="14sp"
          android:textColor="@color/ui_text_secondary"
          android:gravity="center"
          android:layout_marginBottom="18dp"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:fontFamily="sans-serif"
          android:lineSpacingExtra="2sp"/>
      <com.google.android.material.button.MaterialButton
          android:id="@+id/btnAgregarPrimerTrabajo"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="+  Agregar trabajo"
          android:textAllCaps="false"
          android:paddingStart="24dp"
          android:paddingEnd="24dp"
          style="@style/Widget.Chivo.Button"
          android:minHeight="48dp"/>
    </LinearLayout>
    <!-- ============================== -->
    <!-- LISTA DEL PORTAFOLIO            -->
    <!-- Inicialmente oculta             -->
    <!-- ============================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPortafolio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>
  </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

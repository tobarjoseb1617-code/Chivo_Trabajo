<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- CONTENEDOR PRINCIPAL SCROLLABLE -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
      <!-- 1. BARRA SUPERIOR -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="12dp">
        <ImageView
            android:id="@+id/btnRegresarSeguimientoCliente"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_m3_back"
            android:layout_marginEnd="12dp"
            android:contentDescription="Regresar"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackground"
            app:tint="@color/ui_text"
            android:padding="12dp"/>
        <!-- Badge Título -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp">
          <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_marginEnd="4dp"
              android:src="@drawable/ic_m3_shield"
              app:tint="@color/ui_primary"
              android:importantForAccessibility="no"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Seguimiento En Vivo"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <!-- Avatar -->
        <ImageView
            android:id="@+id/btnPerfilDetallesTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/ui_brand"
            android:padding="8dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Perfil"
            android:minHeight="48dp"/>
      </LinearLayout>
      <!-- 2. CABECERA DE LA SOLICITUD (#SOL-8942) -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="14dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#sol-8942"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:background="@drawable/bg_m3_info"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 propuestas"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_success"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Reparación de Fuga en Fregadero"
              android:textSize="17sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="4dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="⏱ Hace 25 min • Urgencia: Hoy"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:drawableStart="@drawable/ic_m3_clock"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- 3. DETALLE DEL PROBLEMA -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="14dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detalle del Problema"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fontanería"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:background="@drawable/bg_m3_info"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Fuga constante en la bacha del fregadero por sifón goteando. Requiere cambio de trampa y..."
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="12dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <!-- Fila de Fotos de Evidencia -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal">
            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:layout_marginEnd="8dp"
                android:contentDescription="Foto 1"/>
            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:contentDescription="Foto 2"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- 4. UBICACIÓN Y HORARIO -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="14dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Ubicación y Horario"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Residencial Cumbres de Cuscatlán\nPasaje 3, Casa #14, Antiguo Cuscatlán"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="6dp"
              android:drawableStart="@drawable/ic_m3_location"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="⏱ Hoy entre 1:00 PM – 3:30 PM"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_primary"
              android:drawableStart="@drawable/ic_m3_clock"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- 5. PRESUPUESTO ESTIMADO -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="20dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presupuesto estimado"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$20.00 – $35.00 usd"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Efectivo /\nTransferencia"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:background="@color/ui_outline"
              android:paddingHorizontal="10dp"
              android:paddingVertical="6dp"
              android:gravity="center"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- 6. PROPUESTAS RECIBIDAS (3 PROFESIONALES) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Propuestas recibidas"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@color/ui_brand"
            android:textColor="#FFFFFF"
            android:text="3"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="8dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ordenadas por cercanía"
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
      </LinearLayout>
      <!-- Propuesta 1: Roberto Méndez (Más Recomendado) -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="14dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <!-- Badge Más Recomendado -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="end"
              android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ Más Recomendado"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#0369A1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:layout_marginEnd="12dp"
                android:contentDescription="Roberto Méndez"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Roberto Méndez"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Maestro Fontanero • 8 años exp."
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:layout_marginTop="2dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginTop="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.9 (142)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_warning"
                    android:layout_marginEnd="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DUI Verificado"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#059669"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:drawableStart="@drawable/ic_m3_shield"
                    android:drawableTint="@color/ui_primary"
                    android:drawablePadding="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>
          <!-- Tarjeta interna de oferta -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:background="@color/ui_background"
              android:padding="12dp"
              android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
              <TextView
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:text="Llega en 15 min"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_success"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Oferta: $25.00 USD"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&quot;Incluye cambio de trampa PVC, 2 empaques de teflón y ajuste hermético con prueba de goteo.&quot;"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textStyle="italic"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
          </LinearLayout>
          <!-- Botones de Acción: Perfil, Chatear, Aceptar -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPerfilPro1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Perfil"
                android:layout_marginEnd="6dp"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChatearPro1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chatear"
                android:layout_marginEnd="6dp"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAceptarPro1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Aceptar"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- Propuesta 2: Carlos Mendoza -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="12dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:layout_marginEnd="10dp"
                android:contentDescription="Carlos Mendoza"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carlos Mendoza"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:layout_marginEnd="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DUI"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#059669"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$28.00 usd"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
              </LinearLayout>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Fontanería 24/7 &amp; Repuestos •  4.8 (89) • En 25 min"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:layout_marginTop="2dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="&quot;Llevo piezas de reemplazo universal...&quot;"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:textStyle="italic"
              android:layout_marginBottom="10dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <com.google.android.material.button.MaterialButton
              android:id="@+id/btnVerPropuesta2"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Ver Propuesta"
              style="@style/Widget.Chivo.Button.Secondary"
              android:minHeight="48dp"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- Propuesta 3: David Ramos -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="24dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"

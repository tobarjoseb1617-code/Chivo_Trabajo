<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- CONTENEDOR PRINCIPAL SCROLLABLE -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
      <!-- 1. BARRA SUPERIOR -->
      <com.google.android.material.appbar.MaterialToolbar
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@color/ui_surface"
          android:elevation="0dp"
          android:minHeight="64dp"
          app:contentInsetStart="0dp"
          app:contentInsetEnd="0dp">
        <!-- App bar Material 3; los botones de regreso conservan sus listeners. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp"
            android:minHeight="64dp">
          <ImageView
              android:id="@+id/btnRegresarDetallePro"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:padding="12dp"
              android:src="@drawable/ic_m3_back"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:clickable="true"
              android:focusable="true"
              android:layout_marginEnd="8dp"
              android:contentDescription="Regresar"
              android:minHeight="48dp"
              app:tint="@color/ui_text"/>
          <!-- Título y código -->
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle de Solicitud"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:id="@+id/tvCodigoDetallePro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#sol-8942"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <!-- Estado Disponible -->
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Disponible"
              android:textSize="22sp"
              android:textStyle="bold"
              android:textColor="@color/ui_success"
              android:background="@drawable/bg_m3_success"
              android:paddingHorizontal="10dp"
              android:paddingVertical="6dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
              android:fontFamily="sans-serif-medium"
              android:maxLines="1"
              android:ellipsize="end"/>
        </LinearLayout>
      </com.google.android.material.appbar.MaterialToolbar>
      <!-- 2. TARJETA PRINCIPAL DEL SERVICIO -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="14dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tvCategoriaDetallePro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fontanería"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:background="@drawable/bg_m3_info"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hace 25 min"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
          </LinearLayout>
          <TextView
              android:id="@+id/tvTituloDetallePro"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Reparación de Fuga en Fregadero"
              android:textSize="17sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="6dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:id="@+id/tvDescripcionDetallePro"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Fuga continua en trampa de desagüe bajo mueble de cocina. Requiere cambio de sellos o piezas con urgencia."
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="12dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <!-- Foto de Evidencia -->
          <RelativeLayout
              android:layout_width="match_parent"
              android:layout_height="140dp"
              android:background="@color/ui_outline">
            <ImageView
                android:id="@+id/ivFotoProblemaDetalle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"
                android:contentDescription="Evidencia"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_margin="8dp"
                android:background="#1F2937"
                android:text="Evidencia (1/2)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:drawableStart="@drawable/ic_m3_camera"
                android:drawableTint="@color/ui_primary"
                android:drawablePadding="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_margin="8dp"
                android:background="#1F2937"
                android:textColor="#FFFFFF"
                android:padding="6dp"
                android:src="@drawable/ic_m3_search"
                app:tint="@color/ui_primary"
                android:importantForAccessibility="no"/>
          </RelativeLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- 3. TARJETA DE INFORMACIÓN DEL CLIENTE (CARLOS RIVERA) -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="14dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:layout_marginEnd="12dp"
                android:contentDescription="Carlos Rivera"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginBottom="2dp">
                <TextView
                    android:id="@+id/tvClienteNombreDetallePro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carlos Rivera"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:layout_marginEnd="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DUI Verificado"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#059669"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:drawableStart="@drawable/ic_m3_shield"
                    android:drawableTint="@color/ui_primary"
                    android:drawablePadding="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
              </LinearLayout>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="4.9 (18 reseñas de profesionales)"
                  android:textSize="14sp"
                  android:textColor="@color/ui_warning"
                  android:textStyle="bold"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
          </LinearLayout>
          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:background="@color/ui_outline"
              android:layout_marginBottom="10dp"/>
          <TextView
              android:id="@+id/tvUbicacionDetallePro"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Cumbres de Cuscatlán, Antiguo Cuscatlán"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="8dp"
              android:drawableStart="@drawable/ic_m3_location"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <TextView
              android:id="@+id/tvHorarioDetallePro"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="⏱ Horario solicitado: Lo antes posible"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_primary"
              android:drawableStart="@drawable/ic_m3_clock"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- 4. PRESUPUESTO DEL CLIENTE -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="20dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Presupuesto del Cliente"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
              <TextView
                  android:id="@+id/tvPresupuestoDetallePro"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="$20.00 – $35.00 usd"
                  android:textSize="16sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Forma de Pago"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Efectivo o Chivo"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Pago protegido y garantizado con ChivoSeguro"
              android:textSize="14sp"
              android:textColor="@color/ui_success"
              android:textStyle="bold"
              android:background="@drawable/bg_m3_success"
              android:padding="8dp"
              android:drawableStart="@drawable/ic_m3_shield"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>


      <!-- 5. SECCIÓN: TU PROPUESTA -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          app:cardBackgroundColor="@color/ui_surface"
          style="@style/Widget.Chivo.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Tu Propuesta"
              android:textSize="18sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="8dp"/>

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Selecciona cómo deseas ofrecer tu servicio:"
              android:textSize="14sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="12dp"/>

          <RadioGroup
              android:id="@+id/rgTipoPropuestaPro"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbAceptarPresupuestoPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aceptar presupuesto del cliente"
                android:textSize="14sp"
                android:textColor="@color/ui_text"
                android:buttonTint="@color/ui_primary"/>

            <RadioButton
                android:id="@+id/rbNuevoPrecioPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Proponer otro precio"
                android:textSize="14sp"
                android:textColor="@color/ui_text"
                android:buttonTint="@color/ui_primary"/>

          </RadioGroup>

          <com.google.android.material.textfield.TextInputLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:hint="Precio exacto (USD)"
              android:layout_marginBottom="8dp"
              style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPrecioPropuestaPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textColor="@color/ui_text"/>

          </com.google.android.material.textfield.TextInputLayout>

          <TextView
              android:id="@+id/tvAyudaPrecioPro"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Selecciona una opción e ingresa el precio que cobrarías."
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="18dp"/>

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="¿En cuánto tiempo puedes llegar?"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="8dp"/>

          <RadioGroup
              android:id="@+id/rgTiempoLlegadaPro"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:layout_marginBottom="18dp">

            <RadioButton
                android:id="@+id/rbLlegada15Pro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="15 min"
                android:textSize="13sp"
                android:textColor="@color/ui_text"
                android:buttonTint="@color/ui_primary"/>

            <RadioButton
                android:id="@+id/rbLlegada30Pro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30 min"
                android:textSize="13sp"
                android:textColor="@color/ui_text"
                android:buttonTint="@color/ui_primary"/>

            <RadioButton
                android:id="@+id/rbLlegadaConvenioPro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A convenir"
                android:textSize="13sp"
                android:textColor="@color/ui_text"
                android:buttonTint="@color/ui_primary"/>

          </RadioGroup>

          <com.google.android.material.textfield.TextInputLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:hint="Mensaje para el cliente (opcional)"
              android:layout_marginBottom="18dp"
              app:counterEnabled="true"
              app:counterMaxLength="300"
              style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMensajePropuestaPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top|start"
                android:minLines="3"
                android:maxLines="5"
                android:maxLength="300"
                android:textColor="@color/ui_text"/>

          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.button.MaterialButton
              android:id="@+id/btnEnviarPropuestaPro"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Enviar propuesta"
              android:minHeight="48dp"
              style="@style/Widget.Chivo.Button"/>

        </LinearLayout>

      </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
  </ScrollView>
</LinearLayout>

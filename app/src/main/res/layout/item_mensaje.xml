<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="5dp" android:orientation="horizontal">
 <com.google.android.material.card.MaterialCardView android:id="@+id/burbuja" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" style="@style/Widget.Chivo.Card">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
   <ImageView android:id="@+id/imagen" android:layout_width="220dp" android:layout_height="160dp" android:scaleType="centerCrop" android:contentDescription="Foto adjunta" android:visibility="gone"/>
   <TextView android:id="@+id/tvTexto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="260dp" android:textColor="@color/ui_text" android:textAppearance="@style/TextAppearance.Material3.BodyMedium"/>
   <TextView android:id="@+id/tvHora" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:textColor="@color/ui_text_secondary" android:textAppearance="@style/TextAppearance.Material3.BodySmall"/>
  </LinearLayout>
 </com.google.android.material.card.MaterialCardView>
</LinearLayout>
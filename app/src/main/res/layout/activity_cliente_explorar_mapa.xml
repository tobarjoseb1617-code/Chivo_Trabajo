<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- CONTENEDOR SUPERIOR -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical">
    <!-- 1. BARRA SUPERIOR -->
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:elevation="0dp"
        android:minHeight="64dp"
        app:contentInsetStart="0dp"
        app:contentInsetEnd="0dp">
      <!-- App bar Material 3; los botones de regreso conservan sus listeners. -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="16dp"
          android:background="@color/ui_surface"
          android:minHeight="64dp">
        <ImageView
            android:id="@+id/btnRegresarExplorar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_m3_back"
            android:layout_marginEnd="12dp"
            android:contentDescription="Regresar"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackground"
            app:tint="@color/ui_text"
            android:padding="12dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ChivoTrabajo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:drawableStart="@drawable/ic_m3_build"
            android:drawableTint="@color/ui_primary"
            android:drawablePadding="8dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="12dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="San Salvador ∨"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:drawableStart="@drawable/ic_m3_location"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/btnPerfilExplorar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/ui_brand"
            android:padding="8dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Perfil"
            android:minHeight="48dp"/>
      </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>
    <!-- 2. SUBBARRA DE EXPLORACIÓN EN VIVO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/ui_surface"
        android:elevation="1dp">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Explorando en vivo\nColonia Escalón, San Salvador"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <View
          android:layout_width="0dp"
          android:layout_height="0dp"
          android:layout_weight="1"/>
      <com.google.android.material.button.MaterialButton
          android:layout_width="38dp"
          android:layout_height="wrap_content"
          android:text=""
          style="@style/Widget.Chivo.Button"
          android:minHeight="48dp"
          app:icon="@drawable/ic_m3_tune"
          app:iconGravity="textStart"
          app:iconPadding="0dp"
          android:contentDescription="Compartir perfil"
          android:minWidth="48dp"/>
    </LinearLayout>
    <!-- 3. FILTROS RÁPIDOS (CHIPS) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">
      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;3 km"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@color/ui_brand"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fontanería"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:background="@color/ui_surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp"
            android:drawableStart="@drawable/ic_m3_build"
            android:drawableTint="@color/ui_primary"
            android:drawablePadding="8dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐  4.5+"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:background="@color/ui_surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponible"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:background="@color/ui_surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
    </HorizontalScrollView>
    <!-- 4. ÁREA DE MAPA SIMULADO -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/ui_outline">
      <!-- Texto de fondo simulando mapa -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:text="[Mapa Interactivo - San Salvador]"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text_secondary"
          android:drawableStart="@drawable/ic_m3_map"
          android:drawableTint="@color/ui_primary"
          android:drawablePadding="8dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <!-- Badge: 14 técnicos activos -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_alignParentTop="true"
          android:layout_marginStart="16dp"
          android:layout_marginTop="16dp"
          android:background="@color/ui_surface"
          android:text="14 técnicos activos"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_success"
          android:paddingHorizontal="12dp"
          android:paddingVertical="6dp"
          android:elevation="4dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <!-- Pin: Roberto M. • 8 min -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:layout_marginStart="-60dp"
          android:layout_marginTop="-40dp"
          android:background="@color/ui_surface"
          android:text="Roberto M. • 8 min"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:padding="6dp"
          android:elevation="4dp"
          android:drawableStart="@drawable/ic_m3_build"
          android:drawableTint="@color/ui_primary"
          android:drawablePadding="8dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <!-- Pin: Tú estás aquí -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_centerInParent="true"
          android:layout_marginTop="30dp"
          android:background="@color/ui_brand"
          android:text="Tú estás aquí"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="#FFFFFF"
          android:padding="8dp"
          android:elevation="4dp"
          android:drawableStart="@drawable/ic_m3_location"
          android:drawableTint="@color/ui_primary"
          android:drawablePadding="8dp"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <!-- Controles de zoom de mapa -->
      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_alignParentEnd="true"
          android:layout_alignParentTop="true"
          android:layout_marginEnd="16dp"
          android:layout_marginTop="16dp"
          android:orientation="vertical"
          android:background="@color/ui_surface"
          android:elevation="4dp"
          android:padding="4dp">
        <com.google.android.material.button.MaterialButton
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="+"
            android:padding="0dp"
            style="@style/Widget.Chivo.Button"
            android:minHeight="48dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ui_outline"/>
        <com.google.android.material.button.MaterialButton
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="-"
            android:padding="0dp"
            style="@style/Widget.Chivo.Button"
            android:minHeight="48dp"/>
      </LinearLayout>
    </RelativeLayout>
  </LinearLayout>
  <!-- 5. TARJETA FLOTANTE INFERIOR: TÉCNICOS EN TU RADAR -->
  <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:cardBackgroundColor="@color/ui_surface"
      android:layout_marginTop="-16dp"
      style="@style/Widget.Chivo.Card">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
      <!-- Cabecera del Radar -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Técnicos en tu Radar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 listos"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_primary"
            android:background="@drawable/bg_m3_info"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="12dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver lista completa"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_primary"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
      <!-- Tarjeta de Roberto Méndez -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_background"
          android:layout_marginBottom="16dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:layout_marginEnd="12dp"
                android:contentDescription="Roberto Méndez"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Roberto Méndez"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:layout_marginEnd="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DUI"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#059669"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
              </LinearLayout>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Fontanero Master • 12 años exp."
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:layout_marginTop="2dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="4.9 (142 servicios)"
                  android:textSize="14sp"
                  android:textColor="@color/ui_warning"
                  android:textStyle="bold"
                  android:layout_marginTop="2dp"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
          </LinearLayout>
          <!-- Distancia y disponibilidad -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="a 1.2 km • 8 min"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:layout_marginEnd="12dp"
                android:drawableStart="@drawable/ic_m3_location"
                android:drawableTint="@color/ui_primary"
                android:drawablePadding="8dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disponible ya"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_success"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <!-- Tarifa estimada y Botones -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Tarifa estimada"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$20 – $35"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:layout_marginEnd="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USD"
                    android:textSize="12sp"
                    android:textColor="@color/ui_text_secondary"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:fontFamily="sans-serif"/>
              </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerPerfilPro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver Perfil"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Chivo.Button.Secondary"
                android:minHeight="48dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSolicitarYa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicitar Ya"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"
                app:icon="@drawable/ic_m3_bolt"
                app:iconSize="20dp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</LinearLayout>

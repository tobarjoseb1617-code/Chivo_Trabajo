<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- BARRA SUPERIOR -->
  <com.google.android.material.appbar.MaterialToolbar
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/ui_surface"
      android:elevation="0dp"
      android:minHeight="64dp"
      app:contentInsetStart="0dp"
      app:contentInsetEnd="0dp">
    <!-- App bar Material 3; los botones de regreso conservan sus listeners. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ui_surface"
        android:paddingHorizontal="16dp"
        android:minHeight="64dp">
      <ImageView
          android:id="@+id/btnRegresarCrearPortafolio"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:padding="12dp"
          android:src="@drawable/ic_m3_back"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:clickable="true"
          android:focusable="true"
          android:layout_marginEnd="8dp"
          android:contentDescription="Regresar"
          android:minHeight="48dp"
          app:tint="@color/ui_text"/>
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Crear Portafolio"
          android:textSize="22sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:ellipsize="end"/>
    </LinearLayout>
  </com.google.android.material.appbar.MaterialToolbar>
  <!-- CONTENIDO SCROLLABLE -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
      <!-- SECCIÓN 1: SOBRE TI -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="16dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Sobre ti (Descripción profesional)"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="4dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Breve resumen visible en tu perfil para que los clientes te conozcan."
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="12dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <com.google.android.material.textfield.TextInputLayout
              style="@style/Widget.Chivo.TextInput"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:hint="Ej: Técnico con más de 12 años de experiencia en fontanería...">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSobreTiCrearPortafolio"
                android:gravity="top|start"
                android:padding="12dp"
                android:textColor="@color/ui_text"
                android:textSize="16sp"
                android:inputType="textMultiLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="110dp"/>
          </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- SECCIÓN 2: ACREDITACIÓN O CARNET PROFESIONAL -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="16dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Acreditación o Carnet Profesional"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="4dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Título o especialidad"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <com.google.android.material.textfield.TextInputLayout
              style="@style/Widget.Chivo.TextInput"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="12dp"
              android:hint="Ej: Técnico en Redes Hidráulicas y Fontanería">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTituloAcreditacion"
                android:paddingHorizontal="12dp"
                android:textColor="@color/ui_text"
                android:textSize="16sp"
                android:inputType="text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"/>
          </com.google.android.material.textfield.TextInputLayout>
          <!-- Tarjeta para adjuntar documento -->
          <LinearLayout
              android:id="@+id/layoutAdjuntarDocumento"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@drawable/bg_input_rounded"
              android:padding="12dp"
              android:clickable="true"
              android:focusable="true"
              android:minHeight="48dp">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:layout_marginEnd="12dp"
                android:contentDescription="Documento"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <TextView
                  android:id="@+id/tvNombreArchivoAdjunto"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Certificado_Profesional.pdf"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Toca para cambiar foto o documento"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="Cambiar"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- SECCIÓN 3: REGISTRAR UN TRABAJO -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="24dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Registrar un Trabajo"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="12dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <!-- Cuadro de subida de foto con previsualización -->
          <FrameLayout
              android:id="@+id/layoutSubirFotoTrabajo"
              android:layout_width="match_parent"
              android:layout_height="140dp"
              android:background="@drawable/bg_input_rounded"
              android:layout_marginBottom="12dp"
              android:clickable="true"
              android:focusable="true">
            <ImageView
                android:id="@+id/ivPreviewTrabajo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Previsualización del trabajo"/>
            <LinearLayout
                android:id="@+id/layoutPlaceholderTrabajo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="+"
                  android:textSize="22sp"
                  android:layout_marginBottom="4dp"
                  android:drawableStart="@drawable/ic_m3_camera"
                  android:drawableTint="@color/ui_primary"
                  android:drawablePadding="8dp"
                  android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:id="@+id/tvEstadoFotoTrabajo"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Subir foto del trabajo"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="JPG o PNG (máx 8MB)"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>
          </FrameLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Título del trabajo"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="6dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <com.google.android.material.textfield.TextInputLayout
              style="@style/Widget.Chivo.TextInput"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="12dp"
              android:hint="Ej: Instalación de Bomba Hidroneumática">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTituloTrabajo"
                android:paddingHorizontal="12dp"
                android:textColor="@color/ui_text"
                android:textSize="16sp"
                android:inputType="text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"/>
          </com.google.android.material.textfield.TextInputLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Descripción del trabajo"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="6dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <com.google.android.material.textfield.TextInputLayout
              style="@style/Widget.Chivo.TextInput"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:hint="Describe brevemente qué trabajo realizaste y la solución ofrecida...">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcionTrabajo"
                android:gravity="top|start"
                android:padding="12dp"
                android:textColor="@color/ui_text"
                android:textSize="16sp"
                android:inputType="textMultiLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="90dp"/>
          </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
  </ScrollView>
  <!-- BOTÓN INFERIOR: GUARDAR PORTAFOLIO -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/ui_surface"
      android:elevation="8dp"
      android:padding="16dp">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardarCrearPortafolio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Portafolio"
        style="@style/Widget.Chivo.Button"
        android:minHeight="48dp"/>
  </LinearLayout>
</LinearLayout>

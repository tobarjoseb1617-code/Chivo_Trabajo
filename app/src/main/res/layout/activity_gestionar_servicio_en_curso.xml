<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F7">

    <!-- CONTENEDOR PRINCIPAL SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. BARRA SUPERIOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/btnRegresarGestion"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Regresar" />

                <!-- Badge Título -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="14sp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detalle De Solicitud"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/btnPerfilGestionTop"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#0B2545"
                    android:padding="8dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Perfil" />
            </LinearLayout>

            <!-- 2. BANNER: SERVICIO EN CURSO ORDEN #3821 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#0B2545"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔵 SERVICIO EN CURSO"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#34D399"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Orden #3821"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️ ChivoSeguro"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#059669"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. TARJETA DE REPARACIÓN Y CLIENTE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔧 Fontanería Residencial"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnLlamarClienteGestion"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:text="📞"
                            android:textSize="16sp"
                            android:gravity="center"
                            android:background="#E0F2FE"
                            android:textColor="#0369A1" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reparación de fuga bajo\nfregadero"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cliente: Carlos Rivera"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 Res. Cumbres de Cuscatlán, Pol. D #14, An..."
                        android:textSize="12sp"
                        android:textColor="#6B7280" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. FASES DE LA ORDEN (STEPPER) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fases de la Orden"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Paso 2 de 5"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <!-- Stepper visual simplificado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="4dp">

                        <!-- Fase 1: Aceptado -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="#059669"
                                android:textColor="#FFFFFF"
                                android:text=" ✓ "
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Aceptado"
                                android:textSize="10sp"
                                android:textColor="#059669"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="30dp"
                            android:layout_height="3dp"
                            android:background="#059669" />

                        <!-- Fase 2: En camino (Activa) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="#0B2545"
                                android:textColor="#FFFFFF"
                                android:text=" 🏍️ "
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="En camino"
                                android:textSize="10sp"
                                android:textColor="#0B2545"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="30dp"
                            android:layout_height="3dp"
                            android:background="#E5E7EB" />

                        <!-- Fase 3: Llegada -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="#E5E7EB"
                                android:textColor="#9CA3AF"
                                android:text=" 📍 "
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Llegada"
                                android:textSize="10sp"
                                android:textColor="#9CA3AF" />
                        </LinearLayout>

                        <View
                            android:layout_width="30dp"
                            android:layout_height="3dp"
                            android:background="#E5E7EB" />

                        <!-- Fase 4: Trabajo -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="#E5E7EB"
                                android:textColor="#9CA3AF"
                                android:text=" 🛠️ "
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Trabajo"
                                android:textSize="10sp"
                                android:textColor="#9CA3AF" />
                        </LinearLayout>

                        <View
                            android:layout_width="30dp"
                            android:layout_height="3dp"
                            android:background="#E5E7EB" />

                        <!-- Fase 5: Cobro -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="#E5E7EB"
                                android:textColor="#9CA3AF"
                                android:text=" 💵 "
                                android:textSize="12sp"
                                android:gravity="center"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cobro"
                                android:textSize="10sp"
                                android:textColor="#9CA3AF" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. MAPA INTERACTIVO Y NAVEGACIÓN GPS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="#E5E7EB"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="🗺️ [Navegación GPS en Ruta]"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#4B5563" />

                        <!-- Badge Tiempo estimado -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:layout_margin="10dp"
                            android:background="#FFFFFF"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:elevation="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱️ "
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tiempo estimado"
                                    android:textSize="9sp"
                                    android:textColor="#9CA3AF" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12 min (3.2 km)"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Badge Tráfico fluido -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:layout_margin="10dp"
                            android:background="#DCFCE7"
                            android:text="🟢 Tráfico fluido"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#166534"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:elevation="4dp" />
                    </RelativeLayout>

                    <!-- Botones GPS y Chat -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnAbrirGpsWaze"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="🧭  Abrir GPS / Waze"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545"
                            android:backgroundTint="#E2E8F0"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btnChatConCarlos"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="💬  Chat con Carlos"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#0B2545" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 6. VALIDACIÓN DE INGRESO RESIDENCIAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#EFF6FF"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪪"
                    android:textSize="22sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Validación de Ingreso Residencial"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1E40AF" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Recuerda presentar tu DUI físico en la caseta de seguridad de Cumbres de Cuscatlán para validar tu pase digital registrado con ChivoSeguro."
                        android:textSize="11sp"
                        android:textColor="#1D4ED8" />
                </LinearLayout>
            </LinearLayout>

            <!-- 7. ACUERDO DE PAGO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ Acuerdo de Pago"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" Garantía 30 días "
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#059669"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mano de obra (diagnóstico y sellado)"
                            android:textSize="12sp"
                            android:textColor="#4B5563" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$25.00\nUSD"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545"
                            android:gravity="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Modalidad de liquidación"
                            android:textSize="11sp"
                            android:textColor="#9CA3AF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Efectivo / Chivo Wallet"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#1F2937" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnRegistrarRepuestos"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="➕  Registrar repuestos o piezas extra"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:backgroundTint="#E2E8F0" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 8. EVIDENCIA DE GARANTÍA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📷 Evidencia de Garantía"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Requerido para ChivoSeguro"
                            android:textSize="10sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>

                    <!-- Fila de fotos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Foto Antes -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="1dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@mipmap/ic_launcher"
                                    android:background="#E5E7EB"
                                    android:contentDescription="Foto Antes" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    android:background="#059669"
                                    android:text=" Foto Antes ✓ "
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:background="#1F2937"
                                    android:text="Fuga previa capturada"
                                    android:textSize="10sp"
                                    android:textColor="#FFFFFF"
                                    android:padding="6dp"
                                    android:gravity="center" />
                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Foto Después (Placeholder) -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnTomarFotoDespues"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#F8FAFC">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📷"
                                    android:textSize="22sp"
                                    android:layout_marginBottom="4dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tomar foto Después"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="#0284C7"
                                    android:gravity="center" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pendiente al culminar"
                                    android:textSize="9sp"
                                    android:textColor="#9CA3AF"
                                    android:gravity="center"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 9. BOTÓN PRINCIPAL: ¡HE LLEGADO A LA UBICACIÓN DEL CLIENTE! -->
            <Button
                android:id="@+id/btnLlegueUbicacion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📍  ¡He llegado a la ubicación del cliente!"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0B2545"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 Carlos Rivera recibirá una notificación automática."
                android:textSize="11sp"
                android:gravity="center"
                android:textColor="#9CA3AF"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- CABECERA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnRegresarSolicitudesPro"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_m3_back"
            android:contentDescription="Regresar"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/ui_text"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solicitudes"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Encuentra trabajos disponibles"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/btnPerfilSolicitudesTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="8dp"
            android:src="@mipmap/ic_launcher"
            android:background="@color/ui_brand"
            android:contentDescription="Perfil"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- INFORMACIÓN -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Chivo.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/ui_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Oportunidades de trabajo"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Explora las solicitudes publicadas por los clientes."
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- CONVERSACIONES -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Chivo.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="@color/ui_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tus conversaciones"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consulta los mensajes de tus clientes"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ui_text_secondary"/>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerPropuestasEnviadas"
                style="@style/Widget.Chivo.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver"
                android:textAllCaps="false"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- TRABAJOS DISPONIBLES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trabajos disponibles"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solicitudes pendientes de asignación"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:textColor="@color/ui_text_secondary"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvCantidadSolicitudesPro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 disponibles"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/ui_primary"
            android:background="@drawable/bg_m3_info"
            android:padding="10dp"/>

    </LinearLayout>

    <!-- FILTROS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroTodasPro"
                style="@style/Widget.Chivo.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="Todas"
                android:textAllCaps="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroCategoriaPro"
                style="@style/Widget.Chivo.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="Mi especialidad"
                android:textAllCaps="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroRecientesPro"
                style="@style/Widget.Chivo.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Más recientes"
                android:textAllCaps="false"/>

        </LinearLayout>

    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progressSolicitudesPro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvSinSolicitudesPro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="No hay solicitudes disponibles por el momento"
        android:textSize="14sp"
        android:textColor="@color/ui_text_secondary"
        android:visibility="gone"/>

</LinearLayout>

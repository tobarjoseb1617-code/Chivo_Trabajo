<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejecución de Servicio"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0B2545"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingrese el PIN de 4 dígitos proporcionado por el cliente:"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etPinIngresado"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#FFFFFF"
        android:hint="PIN de 4 dígitos"
        android:textSize="18sp"
        android:gravity="center"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnValidarPin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Validar PIN e Iniciar Trabajo"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#059669" />

</LinearLayout>

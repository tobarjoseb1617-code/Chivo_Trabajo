<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollRegistroProPaso2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:background="#F4F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- TARJETA BLANCA CENTRAL -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 1. BARRA SUPERIOR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/btnRegresarRegistroProPaso2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Regresar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHIVOTRABAJO"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#9CA3AF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registro Profesional Paso 2"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="#0B2545"
                        android:padding="8dp"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="Perfil" />
                </LinearLayout>


                <!-- 2. BARRA DE PROGRESO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PASO 2 DE 2"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="#0284C7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% Completado"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#059669"
                        android:layout_marginStart="16dp" />
                </LinearLayout>


                <!-- 3. SUBTÍTULO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configura tu oficio y zona de trabajo para comenzar a recibir solicitudes en El Salvador."
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="16dp" />


                <!-- 4. BANNER DE VERIFICACIÓN DUI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#DCFCE7"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_secure"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Verificación" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Podrás verificar tu DUI en tu perfil para obtener el sello de confianza."
                        android:textSize="11sp"
                        android:textColor="#166534" />
                </LinearLayout>


                <!-- 5. OFICIO O ESPECIALIDAD PRINCIPAL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Oficio o Especialidad Principal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="6dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/etEspecialidad"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@+id/tvFlechaEspecialidad"
                        android:background="@null"
                        android:hint="Fontanería y Tuberías"
                        android:textSize="13sp"
                        android:textColor="#1F2937"
                        android:textColorHint="#9CA3AF"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:inputType="text" />

                    <TextView
                        android:id="@+id/tvFlechaEspecialidad"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:gravity="center"
                        android:text="⌄"
                        android:textSize="18sp"
                        android:textColor="#6B7280" />
                </RelativeLayout>


                <!-- 6. SERVICIOS ESPECÍFICOS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Servicios específicos"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:id="@+id/tvContadorServicios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 seleccionados"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0369A1"
                        android:background="#E0F2FE"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>


                <!-- SERVICIOS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <!-- FILA 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvServicioFugas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reparación de fugas"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#4B5563"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tvServicioGriferia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instalación de grifería"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#4B5563"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>


                    <!-- FILA 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvServicioDestape"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Destape de tuberías"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#4B5563"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tvServicioInodoros"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instalación de inodoros"
                            android:textSize="11sp"
                            android:textColor="#4B5563"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>


                    <!-- FILA 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvServicioCisterna"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mantenimiento cisterna"
                            android:textSize="11sp"
                            android:textColor="#4B5563"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                </LinearLayout>


                <!-- 7. EXPERIENCIA LABORAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Experiencia laboral"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1F2937" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Años en el rubro"
                            android:textSize="10sp"
                            android:textColor="#9CA3AF" />
                    </LinearLayout>


                    <!-- CONTADOR -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_rounded"
                        android:paddingHorizontal="4dp">

                        <Button
                            android:id="@+id/btnMenosExperiencia"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="-"
                            android:textSize="16sp"
                            android:backgroundTint="#FFFFFF"
                            android:textColor="#1F2937"
                            android:padding="0dp" />

                        <TextView
                            android:id="@+id/tvAniosExperiencia"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="0 años"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545"
                            android:gravity="center" />

                        <Button
                            android:id="@+id/btnMasExperiencia"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textSize="16sp"
                            android:backgroundTint="#FFFFFF"
                            android:textColor="#1F2937"
                            android:padding="0dp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- DIVISOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginVertical="16dp" />


                <!-- 8. ZONA DE COBERTURA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Zona de cobertura geográfica"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AMSS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0369A1" />
                </LinearLayout>


                <!-- ZONAS SELECCIONADAS -->
                <LinearLayout
                    android:id="@+id/layoutZonasSeleccionadas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <!-- SAN SALVADOR -->
                    <TextView
                        android:id="@+id/tvZonaSanSalvador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="San Salvador Centro  ×"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:background="#E0F2FE"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- SANTA TECLA -->
                    <TextView
                        android:id="@+id/tvZonaSantaTecla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Santa Tecla  ×"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:background="#E0F2FE"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- ANTIGUO CUSCATLÁN -->
                    <TextView
                        android:id="@+id/tvZonaAntiguoCuscatlan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Antiguo Cuscatlán  ×"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:background="#E0F2FE"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>


                <!-- AGREGAR MUNICIPIO -->
                <TextView
                    android:id="@+id/tvAgregarMunicipio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Agregar municipio"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7"
                    android:background="#F1F5F9"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="20dp" />


                <!-- 9. PRESENTACIÓN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Presentación para tus clientes"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:id="@+id/tvContadorDescripcion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 300"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF" />
                </LinearLayout>


                <!-- DESCRIPCIÓN -->
                <EditText
                    android:id="@+id/etDescripcionPro"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Describe brevemente tu experiencia y los servicios que ofreces..."
                    android:textSize="12sp"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:padding="12dp"
                    android:gravity="top|start"
                    android:maxLength="300"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="24dp" />


                <!-- 10. BOTÓN PRINCIPAL -->
                <Button
                    android:id="@+id/btnCompletarRegistroPro"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Completar Registro Profesional"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0B2545"
                    android:layout_marginBottom="10dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- PIE DE PÁGINA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Al completar tu registro aceptas los términos de servicio y las normas de calidad de ChivoTrabajo."
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#9CA3AF"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="16dp" />

    </LinearLayout>

</ScrollView>


<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollRegistroProPaso2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:background="@color/ui_background">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp"
      android:gravity="center_horizontal">
    <!-- TARJETA BLANCA CENTRAL -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/ui_surface"
        style="@style/Widget.Chivo.Card">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="24dp">
        <!-- 1. BARRA SUPERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
          <ImageView
              android:id="@+id/btnRegresarRegistroProPaso2"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:src="@drawable/ic_m3_back"
              android:layout_marginEnd="12dp"
              android:contentDescription="Regresar"
              android:minHeight="48dp"
              android:background="?attr/selectableItemBackground"
              app:tint="@color/ui_text"
              android:padding="12dp"/>
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chivotrabajo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registro Profesional Paso 2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <ImageView
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:background="@color/ui_brand"
              android:padding="8dp"
              android:src="@mipmap/ic_launcher"
              android:contentDescription="Perfil"/>
        </LinearLayout>
        <!-- 2. BARRA DE PROGRESO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 2 de 2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:layout_marginBottom="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="#0284C7"/>
          </LinearLayout>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="100% Completado"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_success"
              android:layout_marginStart="16dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <!-- 3. SUBTÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configura tu oficio y zona de trabajo para comenzar a recibir solicitudes en El Salvador."
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:layout_marginBottom="16dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
        <!-- 4. BANNER DE VERIFICACIÓN DUI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_m3_success"
            android:padding="12dp"
            android:layout_marginBottom="20dp">
          <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:src="@android:drawable/ic_secure"
              android:layout_marginEnd="10dp"
              android:contentDescription="Verificación"/>
          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Podrás verificar tu DUI en tu perfil para obtener el sello de confianza."
              android:textSize="12sp"
              android:textColor="@color/ui_success"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
        <!-- 5. OFICIO O ESPECIALIDAD PRINCIPAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oficio o Especialidad Principal"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:layout_marginBottom="6dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_rounded"
            android:layout_marginBottom="20dp">
          <EditText
              android:id="@+id/etEspecialidad"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:layout_toStartOf="@+id/tvFlechaEspecialidad"
              android:background="@null"
              android:hint="Fontanería y Tuberías"
              android:textSize="16sp"
              android:textColor="@color/ui_text"
              android:textColorHint="@color/ui_text_secondary"
              android:paddingStart="12dp"
              android:paddingEnd="4dp"
              android:inputType="text"
              android:minHeight="48dp"/>
          <TextView
              android:id="@+id/tvFlechaEspecialidad"
              android:layout_width="48dp"
              android:layout_height="match_parent"
              android:layout_alignParentEnd="true"
              android:gravity="center"
              android:text="⌄"
              android:textSize="18sp"
              android:textColor="@color/ui_text_secondary"
              android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="2sp"/>
        </RelativeLayout>
        <!-- 6. SERVICIOS ESPECÍFICOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Servicios específicos"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:id="@+id/tvContadorServicios"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="0 seleccionados"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_primary"
              android:background="@drawable/bg_m3_info"
              android:paddingHorizontal="8dp"
              android:paddingVertical="3dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <!-- SERVICIOS DINÁMICOS -->
        <LinearLayout
            android:id="@+id/layoutServiciosDinamicos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
                </LinearLayout>
        <!-- 7. EXPERIENCIA LABORAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Experiencia laboral"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Años en el rubro"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
          </LinearLayout>
          <!-- CONTADOR -->
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@drawable/bg_input_rounded"
              android:paddingHorizontal="4dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenosExperiencia"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:padding="0dp"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"/>
            <TextView
                android:id="@+id/tvAniosExperiencia"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="0 años"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMasExperiencia"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="+"
                android:padding="0dp"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"/>
          </LinearLayout>
        </LinearLayout>
        <!-- DIVISOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ui_outline"
            android:layout_marginVertical="16dp"/>
        <!-- 8. ZONA DE COBERTURA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Zona de cobertura geográfica"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="AMSS"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_primary"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <!-- ZONAS SELECCIONADAS -->
        <LinearLayout
            android:id="@+id/layoutZonasSeleccionadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">
          <!-- SAN SALVADOR -->
          <TextView
              android:id="@+id/tvZonaSanSalvador"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="San Salvador Centro  ×"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:background="@drawable/bg_m3_info"
              android:paddingHorizontal="10dp"
              android:paddingVertical="6dp"
              android:layout_marginBottom="8dp"
              android:clickable="true"
              android:focusable="true"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"
              android:minHeight="48dp"
              android:gravity="center_vertical"/>
          <!-- SANTA TECLA -->
          <TextView
              android:id="@+id/tvZonaSantaTecla"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Santa Tecla  ×"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:background="@drawable/bg_m3_info"
              android:paddingHorizontal="10dp"
              android:paddingVertical="6dp"
              android:layout_marginBottom="8dp"
              android:clickable="true"
              android:focusable="true"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"
              android:minHeight="48dp"
              android:gravity="center_vertical"/>
          <!-- ANTIGUO CUSCATLÁN -->
          <TextView
              android:id="@+id/tvZonaAntiguoCuscatlan"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Antiguo Cuscatlán  ×"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:background="@drawable/bg_m3_info"
              android:paddingHorizontal="10dp"
              android:paddingVertical="6dp"
              android:layout_marginBottom="8dp"
              android:clickable="true"
              android:focusable="true"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"
              android:minHeight="48dp"
              android:gravity="center_vertical"/>
        </LinearLayout>
        <!-- AGREGAR MUNICIPIO -->
        <TextView
            android:id="@+id/tvAgregarMunicipio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Agregar municipio"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_primary"
            android:background="@color/ui_surface_variant"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="20dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"
            android:minHeight="48dp"
            android:gravity="center_vertical"/>
        <!-- 9. PRESENTACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Presentación para tus clientes"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:id="@+id/tvContadorDescripcion"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="0 / 300"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
        <!-- DESCRIPCIÓN -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Chivo.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Describe brevemente tu experiencia y los servicios que ofreces...">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etDescripcionPro"
              android:textSize="16sp"
              android:textColor="@color/ui_text"
              android:padding="12dp"
              android:gravity="top|start"
              android:maxLength="300"
              android:inputType="textMultiLine"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="110dp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <!-- 10. BOTÓN PRINCIPAL -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompletarRegistroPro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completar Registro Profesional"
            android:layout_marginBottom="10dp"
            style="@style/Widget.Chivo.Button"
            android:minHeight="48dp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- PIE DE PÁGINA -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Al completar tu registro aceptas los términos de servicio y las normas de calidad de ChivoTrabajo."
        android:textSize="12sp"
        android:gravity="center"
        android:textColor="@color/ui_text_secondary"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="16dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:fontFamily="sans-serif"/>
  </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Tarjeta Blanca Central -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 1. BARRA SUPERIOR MOCKUP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/btnRegresarRegistroProPaso2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Regresar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHIVOTRABAJO"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#9CA3AF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registro Profesional Paso 2"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="#0B2545"
                        android:padding="8dp"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="Perfil" />
                </LinearLayout>

                <!-- 2. BARRA DE PROGRESO: PASO 2 DE 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PASO 2 DE 2"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="#0284C7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% Completado"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#059669"
                        android:layout_marginStart="16dp" />
                </LinearLayout>

                <!-- Subtítulo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configura tu oficio y zona de trabajo para comenzar a recibir solicitudes en El Salvador."
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="16dp" />

                <!-- 3. BANNER VERDE DE DUI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#DCFCE7"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="18sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Podrás verificar tu DUI en tu perfil para obtener el sello de confianza y recibir 3x más clientes."
                        android:textSize="11sp"
                        android:textColor="#166534" />
                </LinearLayout>

                <!-- 4. OFICIO O ESPECIALIDAD PRINCIPAL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🛠️ Oficio o Especialidad Principal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="6dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/etEspecialidad"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Fontanería &amp; Tuberías"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="12dp"
                        android:text="∨"
                        android:textSize="14sp"
                        android:textColor="#6B7280" />
                </RelativeLayout>

                <!-- 5. SERVICIOS ESPECÍFICOS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🧰 Servicios específicos"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 seleccionados"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0369A1"
                        android:background="#E0F2FE"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>

                <!-- Chips de servicios específicos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Reparación de fugas"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#0B2545"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Instalación de grifería"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#0B2545"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Destape de tuberías"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="#0B2545"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instalación de inodoros"
                            android:textSize="11sp"
                            android:textColor="#4B5563"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mantenimiento cisterna"
                            android:textSize="11sp"
                            android:textColor="#4B5563"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 6. EXPERIENCIA LABORAL (CONTADOR - / +) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="⏳ Experiencia laboral"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1F2937" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Años en el rubro"
                            android:textSize="10sp"
                            android:textColor="#9CA3AF" />
                    </LinearLayout>

                    <!-- Contador - 7 años + -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_rounded"
                        android:paddingHorizontal="4dp">

                        <Button
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="-"
                            android:textSize="16sp"
                            android:backgroundTint="#FFFFFF"
                            android:textColor="#1F2937"
                            android:padding="0dp" />

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="7 años"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545"
                            android:gravity="center" />

                        <Button
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textSize="16sp"
                            android:backgroundTint="#FFFFFF"
                            android:textColor="#1F2937"
                            android:padding="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginVertical="16dp" />

                <!-- 7. ZONA DE COBERTURA GEOGRÁFICA (AMSS) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📍 Zona de cobertura geográfica"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AMSS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0369A1" />
                </LinearLayout>

                <!-- Chips de Cobertura -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 San Salvador Centro ✕"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 Santa Tecla ✕"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍 Antiguo Cuscatlán ✕"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545"
                            android:background="#E0F2FE"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⊕ Agregar municipio"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0284C7"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 8. PRESENTACIÓN PARA TUS CLIENTES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📝 Presentación para tus clientes"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="144 / 300"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etDescripcionPro"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="Técnico fontanero con 7 años de experiencia en reparaciones residenciales urgentes. Trabajo garantizado, presupuesto transparente y puntualidad..."
                    android:textSize="12sp"
                    android:padding="12dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="24dp" />

                <!-- 9. BOTÓN PRINCIPAL: COMPLETAR REGISTRO PROFESIONAL -->
                <Button
                    android:id="@+id/btnCompletarRegistroPro"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Completar Registro Profesional 🛠️"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0B2545"
                    android:layout_marginBottom="10dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pie de página: Términos y normas de calidad -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Al completar tu registro aceptas los términos de servicio y las normas de calidad de ChivoTrabajo."
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#9CA3AF"
            android:layout_marginBottom="20dp"
            android:paddingHorizontal="16dp" />

    </LinearLayout>
</ScrollView>

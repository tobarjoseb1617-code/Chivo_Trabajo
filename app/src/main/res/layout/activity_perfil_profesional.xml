<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- CONTENEDOR PRINCIPAL SCROLLABLE -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
      <!-- 1. BARRA SUPERIOR -->
      <com.google.android.material.appbar.MaterialToolbar
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@color/ui_surface"
          android:elevation="0dp"
          android:minHeight="64dp"
          app:contentInsetStart="0dp"
          app:contentInsetEnd="0dp">
        <!-- App bar Material 3; los botones de regreso conservan sus listeners. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:minHeight="64dp">
          <ImageView
              android:id="@+id/btnRegresarPerfilPro"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:src="@drawable/ic_m3_back"
              android:layout_marginEnd="12dp"
              android:contentDescription="Regresar"
              android:minHeight="48dp"
              android:background="?attr/selectableItemBackground"
              app:tint="@color/ui_text"
              android:padding="12dp"/>
          <!-- Badge ChivoTrabajo PRO -->
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@drawable/bg_input_rounded"
              android:paddingHorizontal="10dp"
              android:paddingVertical="6dp"
              android:layout_marginEnd="8dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_m3_shield"
                app:tint="@color/ui_primary"
                android:importantForAccessibility="no"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ChivoTrabajo"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:layout_marginEnd="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRO"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@color/ui_brand"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
              </LinearLayout>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Perfil Profesional"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>
          </LinearLayout>
          <View
              android:layout_width="0dp"
              android:layout_height="0dp"
              android:layout_weight="1"/>
          <!-- Estado Disponible -->
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Disponible"
              android:textSize="22sp"
              android:textStyle="bold"
              android:textColor="@color/ui_success"
              android:background="@drawable/bg_m3_success"
              android:paddingHorizontal="10dp"
              android:paddingVertical="6dp"
              android:layout_marginEnd="10dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
              android:fontFamily="sans-serif-medium"
              android:maxLines="1"
              android:ellipsize="end"/>
          <!-- Campana -->
          <ImageView
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:background="@drawable/bg_input_rounded"
              android:padding="8dp"
              android:src="@android:drawable/ic_menu_agenda"
              android:layout_marginEnd="10dp"
              android:contentDescription="Notificaciones"/>
          <!-- Avatar -->
          <ImageView
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:background="@color/ui_brand"
              android:padding="8dp"
              android:src="@mipmap/ic_launcher"
              android:contentDescription="Perfil"/>
        </LinearLayout>
      </com.google.android.material.appbar.MaterialToolbar>
      <!-- 2. TARJETA DE PERFIL DEL PROFESIONAL -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="16dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="16dp">
            <!-- Avatar grande con punto verde -->
            <RelativeLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="16dp">
              <ImageView
                  android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:src="@mipmap/ic_launcher"
                  android:background="@color/ui_outline"
                  android:contentDescription="Roberto Méndez"/>
              <View
                  android:layout_width="16dp"
                  android:layout_height="16dp"
                  android:layout_alignParentEnd="true"
                  android:layout_alignParentBottom="true"
                  android:background="#059669"/>
            </RelativeLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Roberto Méndez"
                  android:textSize="18sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:layout_marginBottom="4dp"
                  android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                  android:fontFamily="sans-serif-medium"/>
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DUI Verificado"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#059669"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="8dp"
                    android:drawableStart="@drawable/ic_m3_shield"
                    android:drawableTint="@color/ui_primary"
                    android:drawablePadding="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
              </LinearLayout>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Fontanero Master &amp; Residencial"
                  android:textSize="14sp"
                  android:textColor="@color/ui_text_secondary"
                  android:layout_marginBottom="2dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                  android:fontFamily="sans-serif"
                  android:lineSpacingExtra="2sp"/>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="4.9 (142)  •   San Salvador, SV • Cobertura 10 km"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:drawableStart="@drawable/ic_m3_location"
                  android:drawableTint="@color/ui_primary"
                  android:drawablePadding="8dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>
          </LinearLayout>
          <!-- Botones de Acción de Perfil -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContratarPerfil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Contratar / Solicitar"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChatPerfil"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginEnd="8dp"
                android:padding="0dp"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"
                app:icon="@drawable/ic_m3_chat"
                app:iconSize="20dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:contentDescription="Abrir chat"
                android:minWidth="48dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompartirPerfil"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text=""
                android:padding="0dp"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"
                app:icon="@drawable/ic_m3_share"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:contentDescription="Compartir perfil"
                android:minWidth="48dp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- 3. PESTAÑAS (TABS): Información | Portafolio | Reseñas -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:background="@color/ui_surface"
          android:elevation="1dp"
          android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Información"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text_secondary"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <!-- Pestaña Portafolio (Seleccionada) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Portafolio"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:paddingVertical="12dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <View
              android:layout_width="match_parent"
              android:layout_height="3dp"
              android:background="@color/ui_brand"/>
        </LinearLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reseñas"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text_secondary"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
      <!-- 4. TRABAJOS REALIZADOS (PORTAFOLIO) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Trabajos Realizados"
              android:textSize="16sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="6 proyectos completados con garantía"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fotos verificadas"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_primary"
            android:background="@drawable/bg_m3_info"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
      <!-- CUADRÍCULA DE PROYECTOS (2 Columnas con LinearLayouts) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginBottom="24dp">
        <!-- Fila 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
          <!-- Proyecto 1: Reparación fuga -->
          <com.google.android.material.card.MaterialCardView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginEnd="6dp"
              app:cardBackgroundColor="@color/ui_surface"
              style="@style/Widget.Chivo.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
              <RelativeLayout android:layout_width="match_parent" android:layout_height="110dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_launcher"
                    android:background="@color/ui_outline"
                    android:contentDescription="Reparación fuga"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="#059669"
                    android:text="Garantía"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="8dp"
                    android:background="#1F2937"
                    android:text="Fugas"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:fontFamily="sans-serif"/>
              </RelativeLayout>
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:padding="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reparación fuga..."
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Col. Escalón"
                    android:textSize="12sp"
                    android:textColor="@color/ui_text_secondary"
                    android:drawableStart="@drawable/ic_m3_location"
                    android:drawableTint="@color/ui_primary"
                    android:drawablePadding="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:fontFamily="sans-serif"/>
              </LinearLayout>
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>
          <!-- Proyecto 2: Instalación de grifería -->
          <com.google.android.material.card.MaterialCardView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginStart="6dp"
              app:cardBackgroundColor="@color/ui_surface"
              style="@style/Widget.Chivo.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
              <RelativeLayout android:layout_width="match_parent" android:layout_height="110dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_launcher"
                    android:background="@color/ui_outline"
                    android:contentDescription="Instalación de grifería"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="#059669"
                    android:text="Garantía"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="8dp"
                    android:background="#1F2937"
                    android:text="Grifería"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:fontFamily="sans-serif"/>
              </RelativeLayout>
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:padding="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instalación de grifería"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Santa Tecla"
                    android:textSize="12sp"
                    android:textColor="@color/ui_text_secondary"
                    android:drawableStart="@drawable/ic_m3_location"
                    android:drawableTint="@color/ui_primary"
                    android:drawablePadding="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:fontFamily="sans-serif"/>
              </LinearLayout>
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <!-- Fila 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
          <!-- Proyecto 3: Bomba y cisterna -->
          <com.google.android.material.card.MaterialCardView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginEnd="6dp"
              app:cardBackgroundColor="@color/ui_surface"
              style="@style/Widget.Chivo.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
              <RelativeLayout android:layout_width="match_parent" android:layout_height="110dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_launcher"
                    android:background="@color/ui_outline"
                    android:contentDescription="Bomba y cisterna"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="#059669"
                    android:text="Garantía"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="8dp"
                    android:background="#1F2937"
                    android:text="Bombas"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:fontFamily="sans-serif"/>
              </RelativeLayout>
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:padding="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bomba y cisterna"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Santa Elena"
                    android:textSize="12sp"
                    android:textColor="@color/ui_text_secondary"
                    android:drawableStart="@drawable/ic_m3_location"
                    android:drawableTint="@color/ui_primary"
                    android:drawablePadding="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:fontFamily="sans-serif"/>
              </LinearLayout>
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>
          <!-- Proyecto 4: Tubería termofusión -->
          <com.google.android.material.card.MaterialCardView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:layout_marginStart="6dp"
              app:cardBackgroundColor="@color/ui_surface"
              style="@style/Widget.Chivo.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
              <RelativeLayout android:layout_width="match_parent" android:layout_height="110dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_launcher"
                    android:background="@color/ui_outline"
                    android:contentDescription="Tubería termofusión"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="#059669"
                    android:text="Garantía"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="8dp"
                    android:background="#1F2937"
                    android:text="Termofusión"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"

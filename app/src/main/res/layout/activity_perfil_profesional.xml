<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F7">

    <!-- CONTENEDOR PRINCIPAL SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. BARRA SUPERIOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- Badge ChivoTrabajo PRO -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="14sp"
                        android:layout_marginEnd="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ChivoTrabajo"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#1F2937"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" PRO "
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="#0B2545"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="1dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Perfil Profesional"
                            android:textSize="10sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Estado Disponible -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Disponible"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#059669"
                    android:background="#DCFCE7"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="10dp" />

                <!-- Campana -->
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input_rounded"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Notificaciones" />

                <!-- Avatar -->
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#0B2545"
                    android:padding="8dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Perfil" />
            </LinearLayout>

            <!-- 2. TARJETA DE PERFIL DEL PROFESIONAL -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <!-- Avatar grande con punto verde -->
                        <RelativeLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@mipmap/ic_launcher"
                                android:background="#E5E7EB"
                                android:contentDescription="Roberto Méndez" />

                            <View
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:background="#059669" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Roberto Méndez"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545"
                                android:layout_marginBottom="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="4dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" 🛡️ DUI Verificado "
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:background="#059669"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:layout_marginEnd="8dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fontanero Master &amp; Residencial"
                                android:textSize="13sp"
                                android:textColor="#4B5563"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="★ 4.9 (142)  •  📍 San Salvador, SV • Cobertura 10 km"
                                android:textSize="11sp"
                                android:textColor="#6B7280" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Botones de Acción de Perfil -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnContratarPerfil"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="🤝  Contratar / Solicitar"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#0B2545"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btnChatPerfil"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="💬"
                            android:backgroundTint="#E2E8F0"
                            android:textColor="#1F2937"
                            android:layout_marginEnd="8dp"
                            android:padding="0dp" />

                        <Button
                            android:id="@+id/btnCompartirPerfil"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="🔗"
                            android:backgroundTint="#E2E8F0"
                            android:textColor="#1F2937"
                            android:padding="0dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. PESTAÑAS (TABS): Información | Portafolio | Reseñas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Información"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:gravity="center"
                    android:paddingVertical="12dp" />

                <!-- Pestaña Portafolio (Seleccionada) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Portafolio"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:paddingVertical="12dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="#0B2545" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reseñas"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#6B7280"
                    android:gravity="center"
                    android:paddingVertical="12dp" />
            </LinearLayout>

            <!-- 4. TRABAJOS REALIZADOS (PORTAFOLIO) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trabajos Realizados"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 proyectos completados con garantía"
                        android:textSize="12sp"
                        android:textColor="#6B7280" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fotos verificadas"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7"
                    android:background="#E0F2FE"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- CUADRÍCULA DE PROYECTOS (2 Columnas con LinearLayouts) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <!-- Fila 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <!-- Proyecto 1: Reparación fuga -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="110dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@mipmap/ic_launcher"
                                    android:background="#E5E7EB"
                                    android:contentDescription="Reparación fuga" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    android:background="#059669"
                                    android:text=" ✓ Garantía "
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:layout_margin="8dp"
                                    android:background="#1F2937"
                                    android:text="Fugas"
                                    android:textSize="9sp"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Reparación fuga..."
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📍 Col. Escalón"
                                    android:textSize="11sp"
                                    android:textColor="#6B7280" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Proyecto 2: Instalación de grifería -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="110dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@mipmap/ic_launcher"
                                    android:background="#E5E7EB"
                                    android:contentDescription="Instalación de grifería" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    android:background="#059669"
                                    android:text=" ✓ Garantía "
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:layout_margin="8dp"
                                    android:background="#1F2937"
                                    android:text="Grifería"
                                    android:textSize="9sp"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Instalación de grifería"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📍 Santa Tecla"
                                    android:textSize="11sp"
                                    android:textColor="#6B7280" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Fila 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <!-- Proyecto 3: Bomba y cisterna -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="110dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@mipmap/ic_launcher"
                                    android:background="#E5E7EB"
                                    android:contentDescription="Bomba y cisterna" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    android:background="#059669"
                                    android:text=" ✓ Garantía "
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:layout_margin="8dp"
                                    android:background="#1F2937"
                                    android:text="Bombas"
                                    android:textSize="9sp"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bomba y cisterna"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📍 Santa Elena"
                                    android:textSize="11sp"
                                    android:textColor="#6B7280" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Proyecto 4: Tubería termofusión -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="110dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@mipmap/ic_launcher"
                                    android:background="#E5E7EB"
                                    android:contentDescription="Tubería termofusión" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    android:background="#059669"
                                    android:text=" ✓ Garantía "
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:layout_margin="8dp"
                                    android:background="#1F2937"
                                    android:text="Termofusión"
                                    android:textSize="9sp"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tubería termofusión"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📍 Antiguo Cuscatlán"
                                    android:textSize="11sp"
                                    android:textColor="#6B7280" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Fila 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Proyecto 5: Cambio de sifón -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="110dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@mipmap/ic_launcher"
                                    android:background="#E5E7EB"
                                    android:contentDescription="Cambio de sifón" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    android:background="#059669"
                                    android:text=" ✓ Garantía "
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:layout_margin="8dp"
                                    android:background="#1F2937"
                                    android:text="Desagües"
                                    android:textSize="9sp"
                                    android:textColor="#FFFFFF"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cambio de sifón y..."
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📍 San Salvador"
                                    android:textSize="11sp"
                                    android:textColor="#6B7280" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Proyecto 6: Calentador de agua -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="110dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"

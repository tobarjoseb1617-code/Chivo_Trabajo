<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ui_background">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp"
      android:gravity="center">
    <!-- Tarjeta Blanca Central -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/ui_surface"
        style="@style/Widget.Chivo.Card">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="24dp">
        <!-- Logo de la app -->
        <ImageView
            android:id="@+id/ivLogoLogin"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Logo"/>
        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="ChivoTrabajo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:fontFamily="sans-serif-medium"/>
        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="Tu red de servicios y oficios de confianza en El Salvador"
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:layout_marginBottom="24dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
        <!-- Etiqueta: Correo -->
        <!-- Input: Correo -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Chivo.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Correo electrónico"
            app:placeholderText="ejemplo@correo.sv">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etLoginCorreo"
              android:textSize="16sp"
              android:textColor="@color/ui_text"
              android:paddingHorizontal="16dp"
              android:inputType="textEmailAddress"
              android:singleLine="true"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="56dp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <!-- Etiqueta Contraseña y ¿La olvidaste? -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Contraseña"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:id="@+id/tvOlvideContrasena"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="¿La olvidaste?"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_primary"
              android:clickable="true"
              android:focusable="true"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"
              android:minHeight="48dp"
              android:gravity="center_vertical"
              android:background="?attr/selectableItemBackground"/>
        </LinearLayout>
        <!-- Input: Contraseña + botón mostrar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_rounded"
            android:layout_marginBottom="12dp">
          <EditText
              android:id="@+id/etLoginContrasena"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:layout_toStartOf="@+id/btnMostrarLoginContrasena"
              android:background="@null"
              android:hint="••••••••"
              android:textSize="16sp"
              android:textColor="@color/ui_text"
              android:textColorHint="@color/ui_text_secondary"
              android:paddingStart="16dp"
              android:paddingEnd="4dp"
              android:inputType="textPassword"
              android:singleLine="true"
              android:minHeight="48dp"/>
          <ImageButton
              android:id="@+id/btnMostrarLoginContrasena"
              android:layout_width="48dp"
              android:layout_height="match_parent"
              android:layout_alignParentEnd="true"
              android:background="@android:color/transparent"
              android:padding="12dp"
              android:src="@drawable/ic_visibility_off"
              android:contentDescription="Mostrar contraseña"
              android:minHeight="48dp"/>
        </RelativeLayout>
        <!-- Checkbox: Mantener mi sesión activa -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbMantenerSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mantener mi sesión activa"
            android:textSize="14sp"
            android:textColor="@color/ui_text_secondary"
            android:layout_marginBottom="20dp"
            android:minHeight="48dp"/>
        <!-- Botón Principal: Iniciar Sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoginCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar sesión"
            android:layout_marginBottom="20dp"
            style="@style/Widget.Chivo.Button"
            android:minHeight="48dp"/>
        <!-- Divisor: O CONTINÚA CON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
          <View
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1"
              android:background="@color/ui_outline"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:paddingHorizontal="12dp"
              android:text="O continúa con"
              android:textSize="14sp"
              android:textColor="@color/ui_text_secondary"
              android:textStyle="bold"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <View
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1"
              android:background="@color/ui_outline"/>
        </LinearLayout>
        <!-- Botón Continuar con Google -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continuar con Google"
            style="@style/Widget.Chivo.Button.Secondary"
            android:minHeight="48dp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Pie de página: ¿No tienes cuenta? Regístrate aquí -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="¿No tienes cuenta?"
          android:textSize="14sp"
          android:textColor="@color/ui_text_secondary"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:fontFamily="sans-serif"
          android:lineSpacingExtra="2sp"/>
      <TextView
          android:id="@+id/btnIrARegistro"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Regístrate aquí"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_primary"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"
          android:minHeight="48dp"
          android:gravity="center_vertical"
          android:background="?attr/selectableItemBackground"
          android:layout_marginStart="8dp"/>
    </LinearLayout>
  </LinearLayout>
</ScrollView>

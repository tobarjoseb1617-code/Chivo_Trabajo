<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Tarjeta Blanca Central -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Logo de la app -->
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Logo" />

                <!-- Título -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="ChivoTrabajo"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0B2545"
                    android:layout_marginBottom="4dp" />

                <!-- Subtítulo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:text="Tu red de servicios y oficios de confianza en El Salvador"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="24dp" />

                <!-- Etiqueta: Correo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Correo"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="6dp" />

                <!-- Input: Correo -->
                <EditText
                    android:id="@+id/etLoginCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="ejemplo@correo.sv"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="textEmailAddress"
                    android:layout_marginBottom="16dp" />

                <!-- Etiqueta Contraseña y ¿La olvidaste? -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Contraseña"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />

                    <TextView
                        android:id="@+id/tvOlvideContrasena"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿La olvidaste?"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0284C7" />
                </LinearLayout>

                <!-- Input: Contraseña -->
                <EditText
                    android:id="@+id/etLoginContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="••••••••"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="textPassword"
                    android:layout_marginBottom="12dp" />

                <!-- Checkbox: Mantener mi sesión activa -->
                <CheckBox
                    android:id="@+id/cbMantenerSesion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mantener mi sesión activa"
                    android:textSize="13sp"
                    android:textColor="#4B5563"
                    android:layout_marginBottom="20dp" />

                <!-- Botón Principal: Iniciar Sesión -->
                <Button
                    android:id="@+id/btnLoginCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Iniciar Sesión ➔"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0B2545"
                    android:layout_marginBottom="20dp" />

                <!-- Divisor: O CONTINÚA CON -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E5E7EB" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:text="O CONTINÚA CON"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E5E7EB" />
                </LinearLayout>

                <!-- Botón Continuar con Google -->
                <Button
                    android:id="@+id/btnGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="G   Continuar con Google"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:backgroundTint="#F3F4F6" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pie de página: ¿No tienes cuenta? Regístrate aquí -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿No tienes cuenta? "
                android:textSize="13sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/btnIrARegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regístrate aquí"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0284C7" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

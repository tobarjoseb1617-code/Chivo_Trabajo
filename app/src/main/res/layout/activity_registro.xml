<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="120dp"
    android:background="@color/ui_background">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp"
      android:gravity="center_horizontal">
    <!-- Tarjeta Blanca Central -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/ui_surface"
        style="@style/Widget.Chivo.Card">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="24dp">
        <!-- 1. BARRA SUPERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
          <ImageView
              android:id="@+id/btnRegresarRegistro"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:src="@drawable/ic_m3_back"
              android:layout_marginEnd="12dp"
              android:contentDescription="Regresar"
              android:minHeight="48dp"
              android:background="?attr/selectableItemBackground"
              app:tint="@color/ui_text"
              android:padding="12dp"/>
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chivotrabajo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registro Paso 1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <ImageView
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:background="@color/ui_brand"
              android:padding="8dp"
              android:src="@mipmap/ic_launcher"
              android:contentDescription="Perfil"/>
        </LinearLayout>
        <!-- 2. BARRA DE PROGRESO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 1 de 2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:layout_marginBottom="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="#0284C7"/>
          </LinearLayout>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="50% completado"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginStart="16dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <!-- 3. TÍTULO Y SUBTÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear Cuenta"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Información básica y selección de tu perfil en la plataforma."
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:layout_marginBottom="16dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
        <!-- 4. SELECCIÓN DE ROL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Cómo deseas usar ChivoTrabajo?"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:layout_marginBottom="2dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona tu objetivo. Podrás configurar servicios detallados en el siguiente paso."
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:layout_marginBottom="12dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
        <!-- TARJETAS DE SELECCIÓN DE ROL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
          <!-- CARD CLIENTE -->
          <com.google.android.material.card.MaterialCardView
              android:id="@+id/cardCliente"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              app:cardBackgroundColor="@color/ui_info_background"
              android:layout_marginBottom="10dp"
              style="@style/Widget.Chivo.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">
              <ImageView
                  android:layout_width="24dp"
                  android:layout_height="24dp"
                  android:gravity="center"
                  android:background="@drawable/bg_m3_info"
                  android:layout_marginEnd="12dp"
                  android:src="@drawable/ic_m3_person"
                  app:tint="@color/ui_primary"
                  android:importantForAccessibility="no"/>
              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">
                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Cliente"
                      android:textSize="14sp"
                      android:textStyle="bold"
                      android:textColor="@color/ui_text"
                      android:layout_marginEnd="8dp"
                      android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                      android:fontFamily="sans-serif-medium"/>
                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Contratar"
                      android:textSize="14sp"
                      android:textStyle="bold"
                      android:textColor="@color/ui_primary"
                      android:background="@drawable/bg_m3_info"
                      android:paddingHorizontal="6dp"
                      android:paddingVertical="2dp"
                      android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                      android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Encuentra profesionales calificados para reparaciones, mantenimiento y proyectos en tu hogar."
                    android:textSize="12sp"
                    android:textColor="@color/ui_text_secondary"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:fontFamily="sans-serif"/>
              </LinearLayout>
              <com.google.android.material.checkbox.MaterialCheckBox
                  android:id="@+id/cbCliente"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:checked="true"
                  android:clickable="false"
                  android:focusable="false"
                  android:minHeight="48dp"
                  android:textSize="14sp"/>
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>
          <!-- CARD PROFESIONAL -->
          <com.google.android.material.card.MaterialCardView
              android:id="@+id/cardProfesional"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              app:cardBackgroundColor="@color/ui_surface"
              style="@style/Widget.Chivo.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">
              <ImageView
                  android:layout_width="24dp"
                  android:layout_height="24dp"
                  android:gravity="center"
                  android:background="@color/ui_surface_variant"
                  android:layout_marginEnd="12dp"
                  android:src="@drawable/ic_m3_build"
                  app:tint="@color/ui_primary"
                  android:importantForAccessibility="no"/>
              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">
                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Profesional"
                      android:textSize="14sp"
                      android:textStyle="bold"
                      android:textColor="@color/ui_text"
                      android:layout_marginEnd="8dp"
                      android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                      android:fontFamily="sans-serif-medium"/>
                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:text="Ofrecer Trabajo"
                      android:textSize="14sp"
                      android:textStyle="bold"
                      android:textColor="@color/ui_success"
                      android:background="@drawable/bg_m3_success"
                      android:paddingHorizontal="6dp"
                      android:paddingVertical="2dp"
                      android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                      android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recibe solicitudes de clientes en tu zona, gestiona cotizaciones y haz crecer tus ingresos."
                    android:textSize="12sp"
                    android:textColor="@color/ui_text_secondary"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:fontFamily="sans-serif"/>
              </LinearLayout>
              <com.google.android.material.checkbox.MaterialCheckBox
                  android:id="@+id/cbProfesional"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:checked="false"
                  android:clickable="false"
                  android:focusable="false"
                  android:minHeight="48dp"
                  android:textSize="14sp"/>
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <!-- 5. CAMPOS: NOMBRE Y APELLIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
          <!-- Nombre -->
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:layout_marginEnd="6dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:layout_marginBottom="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Chivo.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. Carlos">
              <com.google.android.material.textfield.TextInputEditText
                  android:id="@+id/etRegNombre"
                  android:textColor="@color/ui_text"
                  android:textSize="16sp"
                  android:paddingHorizontal="12dp"
                  android:inputType="textPersonName"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:minHeight="56dp"/>
            </com.google.android.material.textfield.TextInputLayout>
          </LinearLayout>
          <!-- Apellido -->
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:layout_marginStart="6dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apellido"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:layout_marginBottom="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Chivo.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. Rivera">
              <com.google.android.material.textfield.TextInputEditText
                  android:id="@+id/etRegApellido"
                  android:textColor="@color/ui_text"
                  android:textSize="16sp"
                  android:paddingHorizontal="12dp"
                  android:inputType="textPersonName"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:minHeight="56dp"/>
            </com.google.android.material.textfield.TextInputLayout>
          </LinearLayout>
        </LinearLayout>
        <!-- 6. CORREO ELECTRÓNICO -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Chivo.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Correo electrónico"
            app:placeholderText="ejemplo@correo.com">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etRegCorreo"
              android:textColor="@color/ui_text"
              android:textSize="16sp"
              android:paddingHorizontal="12dp"
              android:inputType="textEmailAddress"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="56dp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <!-- 7. TELÉFONO MÓVIL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teléfono Móvil"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_rounded"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="4dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Sv +503"
              android:textSize="14sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginEnd="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <View
              android:layout_width="1dp"
              android:layout_height="20dp"
              android:background="@color/ui_outline"
              android:layout_marginEnd="8dp"/>
          <EditText
              android:id="@+id/etRegTelefono"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@null"
              android:hint="7123-4567"
              android:textColor="@color/ui_text"
              android:textColorHint="@color/ui_text_secondary"
              android:textSize="16sp"
              android:inputType="phone"
              android:minHeight="48dp"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Para coordinar trabajos y verificar tu cuenta vía SMS."
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:layout_marginBottom="16dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
        <!-- 8. CONTRASEÑA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_rounded"
            android:layout_marginBottom="4dp">
          <EditText
              android:id="@+id/etRegContrasena"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:layout_toStartOf="@+id/btnMostrarContrasena"
              android:background="@null"
              android:hint="••••••••"
              android:textSize="16sp"
              android:textColor="@color/ui_text"
              android:textColorHint="@color/ui_text_secondary"
              android:paddingStart="12dp"
              android:paddingEnd="4dp"
              android:inputType="textPassword"
              android:minHeight="48dp"/>
          <ImageView
              android:id="@+id/btnMostrarContrasena"
              android:layout_width="48dp"
              android:layout_height="match_parent"
              android:layout_alignParentEnd="true"
              android:padding="16dp"
              android:src="@drawable/ic_visibility_off"
              android:contentDescription="Mostrar contraseña"
              android:clickable="true"
              android:focusable="true"
              android:minHeight="48dp"
              android:background="?attr/selectableItemBackground"/>
        </RelativeLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mínimo 8 caracteres, incluye letras y números."
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:layout_marginBottom="16dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
        <!-- 9. TARJETA DE PROTECCIÓN DE DATOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_m3_success"
            android:padding="12dp"
            android:layout_marginBottom="20dp">
          <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_marginEnd="10dp"
              android:src="@drawable/ic_m3_shield"
              app:tint="@color/ui_primary"
              android:importantForAccessibility="no"/>
          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="Tus datos personales están protegidos con cifrado y normativas de confidencialidad de El Salvador."
              android:textSize="12sp"
              android:textColor="@color/ui_success"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
        <!-- 10. BOTÓN PRINCIPAL -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continuar al Paso 2"
            android:layout_marginBottom="16dp"
            style="@style/Widget.Chivo.Button"
            android:minHeight="48dp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Pie de página -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="¿Ya tienes cuenta?"
          android:textSize="14sp"
          android:textColor="@color/ui_text_secondary"
          android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
          android:fontFamily="sans-serif"
          android:lineSpacingExtra="2sp"/>
      <TextView
          android:id="@+id/btnVolverLogin"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Iniciar Sesión"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"
          android:minHeight="48dp"
          android:gravity="center_vertical"
          android:background="?attr/selectableItemBackground"/>
    </LinearLayout>
  </LinearLayout>
</ScrollView>

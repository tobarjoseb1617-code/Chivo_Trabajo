<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Tarjeta Blanca Central -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 1. BARRA SUPERIOR MOCKUP -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/btnRegresarRegistro"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Regresar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHIVOTRABAJO"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="#9CA3AF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registro Paso 1"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="#0B2545"
                        android:padding="8dp"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="Perfil" />
                </LinearLayout>

                <!-- 2. BARRA DE PROGRESO: PASO 1 DE 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PASO 1 DE 2"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#0369A1"
                            android:layout_marginBottom="4dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="#0284C7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50% completado"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#6B7280"
                        android:layout_marginStart="16dp" />
                </LinearLayout>

                <!-- 3. TÍTULO Y SUBTÍTULO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crear Cuenta"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#0B2545"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Información básica y selección de tu perfil en la plataforma."
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="16dp" />

                <!-- 4. ¿CÓMO DESEAS USAR CHIVOTRABAJO? -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Cómo deseas usar ChivoTrabajo?"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0B2545"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selecciona tu objetivo. Podrás configurar servicios detallados en el siguiente paso."
                    android:textSize="11sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="12dp" />

                <!-- Tarjetas de Selección de Rol -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <!-- Card Cliente -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#F8FAFC"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:text="👤"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:background="#E0F2FE"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Cliente"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="#0B2545"
                                        android:layout_marginEnd="8dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" Contratar "
                                        android:textSize="9sp"
                                        android:textStyle="bold"
                                        android:textColor="#0369A1"
                                        android:background="#E0F2FE"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="2dp" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Encuentra profesionales calificados para reparaciones, mantenimiento y proyectos en tu hogar."
                                    android:textSize="11sp"
                                    android:textColor="#6B7280" />
                            </LinearLayout>

                            <CheckBox
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:clickable="false" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card Profesional -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardProfesional"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:text="🛠️"
                                android:textSize="18sp"
                                android:gravity="center"
                                android:background="#F1F5F9"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="2dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Profesional"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="#0B2545"
                                        android:layout_marginEnd="8dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" Ofrecer Trabajo "
                                        android:textSize="9sp"
                                        android:textStyle="bold"
                                        android:textColor="#166534"
                                        android:background="#DCFCE7"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="2dp" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Recibe solicitudes de clientes en tu zona, gestiona cotizaciones y haz crecer tus ingresos."
                                    android:textSize="11sp"
                                    android:textColor="#6B7280" />
                            </LinearLayout>

                            <CheckBox
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false"
                                android:clickable="false" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- 5. CAMPOS: NOMBRE Y APELLIDO (2 Columnas) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Nombre -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nombre"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#1F2937"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etRegNombre"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input_rounded"
                            android:hint="Ej. Carlos"
                            android:textSize="13sp"
                            android:paddingHorizontal="12dp"
                            android:inputType="textPersonName" />
                    </LinearLayout>

                    <!-- Apellido -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Apellido"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#1F2937"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etRegApellido"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input_rounded"
                            android:hint="Ej. Rivera"
                            android:textSize="13sp"
                            android:paddingHorizontal="12dp"
                            android:inputType="textPersonName" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 6. CORREO ELECTRÓNICO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Correo Electrónico"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etRegCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="ejemplo@correo.com"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:inputType="textEmailAddress"
                    android:layout_marginBottom="16dp" />

                <!-- 7. TELÉFONO MÓVIL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Teléfono Móvil"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SV +503"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginEnd="8dp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:background="#E5E7EB"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etRegTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="7123-4567"
                        android:textSize="13sp"
                        android:inputType="phone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Para coordinar trabajos y verificar tu cuenta vía SMS."
                    android:textSize="10sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginBottom="16dp" />

                <!-- 8. CONTRASEÑA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contraseña"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="4dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_rounded"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/etRegContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="••••••••"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:inputType="textPassword" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="12dp"
                        android:text="👁️"
                        android:textSize="16sp" />
                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mínimo 8 caracteres, incluye letras y números."
                    android:textSize="10sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginBottom="16dp" />

                <!-- 9. TARJETA DE PROTECCIÓN DE DATOS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#DCFCE7"
                    android:padding="12dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="18sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tus datos personales están protegidos con cifrado y normativas de confidencialidad de El Salvador."
                        android:textSize="11sp"
                        android:textColor="#166534" />
                </LinearLayout>

                <!-- 10. BOTÓN PRINCIPAL: CONTINUAR AL PASO 2 -->
                <Button
                    android:id="@+id/btnRegistrar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Continuar al Paso 2 ➔"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0B2545"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pie de página: ¿Ya tienes cuenta? Iniciar Sesión -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes cuenta? "
                android:textSize="13sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/btnVolverLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar Sesión"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0B2545" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

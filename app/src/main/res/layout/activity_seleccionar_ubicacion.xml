<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- BARRA SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnRegresarMapa"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Regresar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Seleccionar Ubicación"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0B2545" />
    </LinearLayout>

    <!-- BUSCADOR Y UBICACIÓN ACTUAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="1dp">

        <EditText
            android:id="@+id/etBuscarUbicacion"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_rounded"
            android:hint="Buscar dirección o lugar..."
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            android:inputType="text"
            android:autofillHints="postalAddress"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnBuscarUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="🔍"
            android:backgroundTint="#0B2545"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnUbicacionActual"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="📍 GPS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- MAPA WEBVIEW -->
    <WebView
        android:id="@+id/mapWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- BOTÓN CONFIRMAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="16dp">

        <Button
            android:id="@+id/btnConfirmarUbicacion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✓  Confirmar Ubicación"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B2545" />
    </LinearLayout>

</LinearLayout>

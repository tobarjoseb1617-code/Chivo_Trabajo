<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background">
  <!-- Ajuste para presentación: títulos de 20sp y etiquetas compactas; se conserva el tamaño táctil y la escala de texto del teléfono. -->
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- Toolbar / Barra Superior -->
  <com.google.android.material.appbar.MaterialToolbar
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/ui_surface"
      android:elevation="0dp"
      android:minHeight="64dp"
      app:contentInsetStart="0dp"
      app:contentInsetEnd="0dp">
    <!-- App bar Material 3; los botones de regreso conservan sus listeners. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ui_surface"
        android:paddingHorizontal="16dp"
        android:minHeight="64dp">
      <ImageView
          android:id="@+id/btnRegresar"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:src="@drawable/ic_m3_back"
          android:contentDescription="Regresar"
          android:layout_marginEnd="16dp"
          android:minHeight="48dp"
          android:background="?attr/selectableItemBackground"
          app:tint="@color/ui_text"
          android:padding="12dp"/>
      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Mi perfil"
          android:textSize="20sp"
          android:textStyle="normal"
          android:textColor="@color/ui_text"
          android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:ellipsize="end"/>
    </LinearLayout>
  </com.google.android.material.appbar.MaterialToolbar>
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
      <!-- Tarjeta de Datos del Usuario -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          app:cardBackgroundColor="@color/ui_surface"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">
          <!-- Avatar / Foto de Perfil -->
          <ImageView
              android:id="@+id/ivFotoPerfil"
              android:layout_width="80dp"
              android:layout_height="80dp"
              android:layout_marginBottom="6dp"
              android:src="@mipmap/ic_launcher"
              android:background="@color/ui_outline"
              android:padding="4dp"
              android:clickable="true"
              android:focusable="true"
              android:contentDescription="Avatar"
              android:minHeight="48dp"/>
          <TextView
              android:id="@+id/tvCambiarFoto"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Cambiar foto de perfil"
              android:textSize="13sp"
              android:textColor="@color/ui_primary"
              android:textStyle="bold"
              android:layout_marginBottom="12dp"
              android:background="?attr/selectableItemBackground"
              android:padding="4dp"
              android:drawableStart="@drawable/ic_m3_camera"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <!-- Nombre del Usuario -->
          <TextView
              android:id="@+id/tvNombreUsuario"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Cargando usuario..."
              android:textSize="20sp"
              android:textStyle="normal"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="4dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
              android:fontFamily="sans-serif-medium"/>
          <!-- Tipo de Usuario y Estado -->
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/tvTipoUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cliente"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@color/ui_brand"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:id="@+id/tvEstadoVerificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendiente"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_warning"
                android:background="@drawable/bg_m3_warning"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:background="@color/ui_outline"
              android:layout_marginBottom="16dp"/>
          <!-- Detalles -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correo Electrónico"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
            <TextView
                android:id="@+id/tvCorreoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="correo@ejemplo.com"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:layout_marginBottom="12dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Teléfono"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
            <TextView
                android:id="@+id/tvTelefonoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0000-0000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- Tarjeta de Opciones de Configuración -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="24dp"
          app:cardBackgroundColor="@color/ui_surface"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Configuración de Cuenta"
              android:textSize="13sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:paddingHorizontal="16dp"
              android:paddingVertical="12dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:background="@color/ui_background"/>
          <!-- Apariencia: apagado = claro, encendido = oscuro; se conserva al reiniciar. -->
          <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/switchModoOscuro"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="56dp"
              android:text="Modo oscuro"
              android:textSize="14sp"
              android:textColor="@color/ui_text"
              android:paddingHorizontal="16dp"
              android:paddingVertical="8dp"/>
          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:background="@color/ui_outline"/>
          <!-- Opción 1 -->
          <TextView
              android:id="@+id/tvEditarPerfil"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Editar Información Personal"
              android:textSize="14sp"
              android:textColor="@color/ui_text"
              android:paddingHorizontal="16dp"
              android:paddingVertical="16dp"
              android:background="?attr/selectableItemBackground"
              android:drawableStart="@drawable/ic_m3_edit"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="2sp"
              android:minHeight="48dp"
              android:gravity="center_vertical"/>
          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:background="@color/ui_background"/>
          <!-- Opción Verificar DUI -->
          <TextView
              android:id="@+id/tvVerificarDui"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Verificar Identidad (DUI)"
              android:textSize="14sp"
              android:textColor="@color/ui_text"
              android:paddingHorizontal="16dp"
              android:paddingVertical="16dp"
              android:background="?attr/selectableItemBackground"
              android:drawableStart="@drawable/ic_m3_shield"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="2sp"
              android:minHeight="48dp"
              android:gravity="center_vertical"/>
          <!-- Opción Mi Portafolio -->
          <LinearLayout
              android:id="@+id/layoutMiPortafolio"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:visibility="visible">
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ui_background"/>
            <LinearLayout
                android:id="@+id/btnMiPortafolio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="48dp">
              <ImageView
                  android:layout_width="24dp"
                  android:layout_height="24dp"
                  android:gravity="center_vertical"
                  android:src="@drawable/ic_m3_image"
                  app:tint="@color/ui_primary"
                  android:importantForAccessibility="no"/>
              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:layout_marginStart="4dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mi Portafolio"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Administra y publica tus trabajos realizados"
                    android:textSize="12sp"
                    android:textColor="@color/ui_text_secondary"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:fontFamily="sans-serif"/>
              </LinearLayout>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="›"
                  android:textSize="20sp"
                  android:textColor="@color/ui_text_secondary"
                  android:paddingStart="8dp"
                  android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                  android:fontFamily="sans-serif-medium"
                  android:textStyle="normal"/>
            </LinearLayout>
          </LinearLayout>
          <!-- Opción 2 -->
          <TextView
              android:id="@+id/tvSoporte"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Ayuda y Soporte ChivoTrabajo"
              android:textSize="14sp"
              android:textColor="@color/ui_text"
              android:paddingHorizontal="16dp"
              android:paddingVertical="16dp"
              android:background="?attr/selectableItemBackground"
              android:drawableStart="@drawable/ic_m3_chat"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="2sp"
              android:minHeight="48dp"
              android:gravity="center_vertical"/>
          <!-- Opción 3 -->
          <TextView
              android:id="@+id/tvTerminos"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Términos y Condiciones"
              android:textSize="14sp"
              android:textColor="@color/ui_text"
              android:paddingHorizontal="16dp"
              android:paddingVertical="16dp"
              android:background="?attr/selectableItemBackground"
              android:drawableStart="@drawable/ic_m3_list"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="2sp"
              android:minHeight="48dp"
              android:gravity="center_vertical"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- Botón Cerrar Sesión -->
      <com.google.android.material.button.MaterialButton
          android:id="@+id/btnCerrarSesion"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Cerrar Sesión"
          style="@style/Widget.Chivo.Button.Secondary"
          android:minHeight="48dp"
          android:textColor="@color/ui_error"
          app:strokeColor="@color/ui_error"
          android:textSize="14sp"/>
    </LinearLayout>
  </ScrollView>
</LinearLayout>

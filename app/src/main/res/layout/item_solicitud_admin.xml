<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#1B2636"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#43536A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategoriaSolicitudAdmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Categoría del servicio"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstadoSolicitudAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_m3_warning"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="Pendiente"
                android:textColor="@color/ui_warning"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDescripcionSolicitudAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Descripción de la solicitud"
            android:textColor="#D1D9E3"
            android:textSize="16sp"
            android:maxLines="3" />

        <TextView
            android:id="@+id/tvCiudadSolicitudAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ciudad"
            android:textColor="#E5EAF0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvFechaSolicitudAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Fecha de creación"
            android:textColor="#AEBBCB"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetallesSolicitudAdmin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:text="Ver detalles"
            android:textColor="#123047"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="#7DD3F7"
            app:cornerRadius="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

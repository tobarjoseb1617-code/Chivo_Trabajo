<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true"
      android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp">

      <!-- BARRA SUPERIOR -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="18dp">

        <ImageView
            android:id="@+id/btnRegresarHistorialSolicitudesCliente"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_m3_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Regresar"
            app:tint="@color/ui_text"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_input_rounded"
            android:padding="9dp"
            android:src="@drawable/ic_m3_notifications"
            android:layout_marginEnd="10dp"
            android:contentDescription="Notificaciones"
            app:tint="@color/ui_text_secondary"/>

        <ImageView
            android:id="@+id/btnPerfilHistorialClienteTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/ui_brand"
            android:padding="8dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Perfil"/>

      </LinearLayout>

      <!-- TÍTULO Y NUEVA SOLICITUD -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Panel cliente"
              android:textSize="13sp"
              android:textColor="@color/ui_text_secondary"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:text="Mis Solicitudes"
              android:textSize="20sp"
              android:textColor="@color/ui_text"
              android:fontFamily="sans-serif-medium"
              android:textAppearance="@style/TextAppearance.Material3.TitleLarge"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublicarNuevaSolicitud"
            style="@style/Widget.Chivo.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="+ Nueva solicitud"
            android:textAllCaps="false"
            android:textSize="14sp"/>

      </LinearLayout>

      <!-- BUSCADOR -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_marginBottom="14dp"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/bg_input_rounded"
          android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_m3_search"
            android:importantForAccessibility="no"
            app:tint="@color/ui_primary"/>

        <EditText
            android:id="@+id/etBuscarSolicitudCliente"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Buscar por servicio o #SOL..."
            android:textSize="14sp"
            android:textColor="@color/ui_text"
            android:textColorHint="@color/ui_text_secondary"
            android:inputType="text"
            android:singleLine="true"/>

      </LinearLayout>

      <!-- FILTROS -->
      <HorizontalScrollView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="20dp"
          android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

          <com.google.android.material.button.MaterialButton
              android:id="@+id/btnFiltroTodasCliente"
              style="@style/Widget.Chivo.Button"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginEnd="8dp"
              android:text="Todas"
              android:textAllCaps="false"/>

          <com.google.android.material.button.MaterialButton
              android:id="@+id/btnFiltroAbiertasCliente"
              style="@style/Widget.Chivo.Button.Secondary"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginEnd="8dp"
              android:text="Abiertas"
              android:textAllCaps="false"/>

          <com.google.android.material.button.MaterialButton
              android:id="@+id/btnFiltroProcesoCliente"
              style="@style/Widget.Chivo.Button.Secondary"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginEnd="8dp"
              android:text="En proceso"
              android:textAllCaps="false"/>

          <com.google.android.material.button.MaterialButton
              android:id="@+id/btnFiltroFinalizadasCliente"
              style="@style/Widget.Chivo.Button.Secondary"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Finalizadas"
              android:textAllCaps="false"/>

        </LinearLayout>

      </HorizontalScrollView>

      <!-- ENCABEZADO DE LISTA -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          android:orientation="horizontal"
          android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tus solicitudes"
            android:textSize="17sp"
            android:textColor="@color/ui_text"
            android:fontFamily="sans-serif-medium"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"/>

        <TextView
            android:id="@+id/tvCantidadSolicitudesCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 solicitudes"
            android:textSize="13sp"
            android:textColor="@color/ui_text_secondary"/>

      </LinearLayout>

      <!-- INDICADOR DE CARGA -->
      <ProgressBar
          android:id="@+id/progressSolicitudesCliente"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_margin="20dp"
          android:visibility="gone"/>

      <!-- LISTA DINÁMICA DE FIRESTORE -->
      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvSolicitudesCliente"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:nestedScrollingEnabled="false"
          android:clipToPadding="false"
          android:visibility="visible"/>

      <!-- MENSAJE SIN SOLICITUDES -->
      <LinearLayout
          android:id="@+id/layoutSinSolicitudesCliente"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:layout_marginBottom="24dp"
          android:orientation="vertical"
          android:gravity="center"
          android:padding="20dp"
          android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_m3_build"
            android:contentDescription="Sin solicitudes"
            app:tint="@color/ui_text_secondary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Aún no tienes solicitudes"
            android:textSize="17sp"
            android:textColor="@color/ui_text"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cuando publiques una solicitud, aparecerá aquí para que puedas consultar su estado."
            android:textSize="13sp"
            android:textColor="@color/ui_text_secondary"
            android:gravity="center"/>

      </LinearLayout>

      <!-- INFORMACIÓN CHIVOTRABAJO -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:layout_marginBottom="16dp"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/bg_m3_success"
          android:padding="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_m3_shield"
            android:importantForAccessibility="no"
            app:tint="@color/ui_primary"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="ChivoTrabajo"
              android:textSize="13sp"
              android:textColor="@color/ui_success"
              android:fontFamily="sans-serif-medium"/>

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:text="Consulta aquí el estado de tus solicitudes y los servicios que has contratado."
              android:textSize="12sp"
              android:textColor="@color/ui_success"/>

        </LinearLayout>

      </LinearLayout>

    </LinearLayout>

  </ScrollView>

  <!-- NAVEGACIÓN INFERIOR -->
  <com.google.android.material.bottomnavigation.BottomNavigationView
      android:id="@+id/bottomNavigation"
      style="@style/Widget.Chivo.Navigation"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:menu="@menu/menu_activity_historial_solicitudes_cliente"/>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:paddingTop="16dp">

            <!-- 1. BARRA SUPERIOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/btnRegresarSeguimientoCliente"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Regresar"
                    android:focusable="true"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_m3_back"
                    app:tint="@color/ui_text" />

                <!-- Badge Título -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_m3_shield"
                        app:tint="@color/ui_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Seguimiento en Vivo"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/ui_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Avatar Perfil -->
                <ImageView
                    android:id="@+id/btnPerfilTop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@color/ui_brand"
                    android:contentDescription="Perfil"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:src="@mipmap/ic_launcher" />

            </LinearLayout>

            <!-- 2. PIN DE SEGURIDAD Y NOTIFICACIONES DE LLEGADA / PIN -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Chivo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ui_brand">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="PIN de Seguridad ChivoSeguro"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="#93C5FD"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPinCodigoCliente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#1E3A8A"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="#3821"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Muestra o entrega este PIN al técnico al llegar para autorizar el inicio del servicio."
                        android:textColor="#CBD5E1"
                        android:textSize="12sp" />

                    <!-- NOTIFICACIÓN 1: El técnico ha llegado -->
                    <LinearLayout
                        android:id="@+id/layoutAlertaLlegada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_m3_success"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_m3_location"
                            app:tint="@color/ui_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="¡El técnico ha llegado!"
                                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                                android:textColor="@color/ui_success"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Mario Estrada se encuentra en la ubicación indicada."
                                android:textColor="@color/ui_success"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- NOTIFICACIÓN 2: PIN verificado correctamente -->
                    <LinearLayout
                        android:id="@+id/layoutAlertaPinVerificado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_m3_info"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_m3_shield"
                            app:tint="@color/ui_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="✓ PIN verificado con éxito. Servicio autorizado."
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/ui_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 3. TARJETA DE REPARACIÓN Y TÉCNICO -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Chivo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ui_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_m3_info"
                            android:drawablePadding="8dp"
                            android:drawableStart="@drawable/ic_m3_build"
                            app:drawableTint="@color/ui_primary"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Fontanería Residencial"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/ui_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#059669"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="Garantía $25.00"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Reparación de fuga bajo fregadero"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/ui_text"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="8dp"
                            android:background="@color/ui_outline"
                            android:contentDescription="Foto del profesional"
                            android:src="@mipmap/ic_launcher" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Téc. Mario Estrada"
                                android:textColor="@color/ui_text"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="4.9 ★ • DUI Verificado"
                                android:textColor="@color/ui_success"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/ic_m3_location"
                        app:drawableTint="@color/ui_primary"
                        android:fontFamily="sans-serif"
                        android:text="Res. Cumbres de Cuscatlán, Polígono D #14"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 4. STEPPER DE FASES DEL SERVICIO (AVANCE DEL CLIENTE) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Chivo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ui_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Estado del Servicio"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/ui_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_m3_info"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Paso 3 de 5"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/ui_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Visual de fases -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginBottom="4dp"
                                android:background="#059669"
                                android:gravity="center"
                                android:text="✓"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Aceptado"
                                android:textColor="@color/ui_success"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="#059669" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginBottom="4dp"
                                android:background="#059669"
                                android:gravity="center"
                                android:text="✓"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="En camino"
                                android:textColor="@color/ui_success"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="#059669" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginBottom="4dp"
                                android:background="@color/ui_brand"
                                android:gravity="center"
                                android:text="●"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Llegada"
                                android:textColor="@color/ui_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="20dp"
                            android:layout_height="2dp"
                            android:background="@color/ui_outline" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginBottom="4dp"
                                android:background="@color/ui_outline"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_m3_build"
                                app:tint="@color/ui_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Trabajo"
                                android:textColor="@color/ui_text_secondary"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 5. RASTREO GPS Y CHAT -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Chivo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ui_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/ui_outline">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:drawablePadding="8dp"
                            android:drawableStart="@drawable/ic_m3_map"
                            app:drawableTint="@color/ui_primary"
                            android:fontFamily="sans-serif-medium"
                            android:text="[Rastreo GPS del Técnico]"
                            android:textColor="@color/ui_text_secondary"
                            android:textSize="14sp" />

                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerMapaCliente"
                            style="@style/Widget.Chivo.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="Ver mapa GPS"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_m3_map"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChatConProfesional"
                            style="@style/Widget.Chivo.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="Chat con técnico"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_m3_chat"
                            app:iconSize="18dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 6. RECUADRO DE PIEZAS Y REPUESTOS REGISTRADOS POR EL TÉCNICO (SOLO LECTURA DEL CLIENTE) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Chivo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ui_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="8dp"
                            android:drawableStart="@drawable/ic_m3_build"
                            app:drawableTint="@color/ui_primary"
                            android:fontFamily="sans-serif-medium"
                            android:text="Piezas y Repuestos Extra"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            android:textColor="@color/ui_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_m3_info"
                            android:fontFamily="sans-serif"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="Registrado por el técnico"
                            android:textColor="@color/ui_primary"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/contenedorRepuestosCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/ui_background"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif"
                                android:text="• Cinta teflón industrial"
                                android:textColor="@color/ui_text"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="$3.50 USD"
                                android:textColor="@color/ui_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif"
                                android:text="• Empaque de alta presión 1/2 pulgada"
                                android:textColor="@color/ui_text"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="$4.00 USD"
                                android:textColor="@color/ui_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 7. EVIDENCIAS FOTOGRÁFICAS (ANTES Y DESPUÉS) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Chivo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ui_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/ic_m3_camera"
                        app:drawableTint="@color/ui_primary"
                        android:fontFamily="sans-serif-medium"
                        android:text="Fotos de Evidencia ChivoSeguro"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/ui_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Foto Antes -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Chivo.Card"
                            android:layout_width="0dp"

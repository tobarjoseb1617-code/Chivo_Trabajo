<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F7">

    <!-- CONTENEDOR PRINCIPAL SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. BARRA SUPERIOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/btnRegresarCalificar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Regresar" />

                <!-- Badge Título -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="14sp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trabajo Completado"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/btnPerfilCalificarTop"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#0B2545"
                    android:padding="8dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Perfil" />
            </LinearLayout>

            <!-- 2. SELLO DE ÉXITO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟢 SERVICIO FINALIZADO CON ÉXITO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#065F46"
                android:background="#D1FAE5"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:layout_marginBottom="16dp" />

            <!-- 3. TARJETA DEL PROFESIONAL Y FACTURA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Info Profesional -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@mipmap/ic_launcher"
                            android:background="#E5E7EB"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="Roberto Méndez" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="2dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Roberto Méndez"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" 🛡️ DUI Verificado "
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:background="#059669"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="2dp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fontanería Residencial"
                                android:textSize="12sp"
                                android:textColor="#4B5563" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginBottom="12dp" />

                    <!-- Detalle del servicio -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reparación de Fuga de Agua"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Santa Tecla"
                            android:textSize="12sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tubo bajo fregadero de cocina principal"
                        android:textSize="12sp"
                        android:textColor="#4B5563"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⏱️ Hoy • 1h 15 min de trabajo"
                        android:textSize="11sp"
                        android:textColor="#0369A1"
                        android:layout_marginBottom="14dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginBottom="12dp" />

                    <!-- Desglose de cobro -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mano de obra certificada"
                            android:textSize="12sp"
                            android:textColor="#4B5563" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$20.00 USD"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#1F2937" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Repuestos y sellos PVC"
                            android:textSize="12sp"
                            android:textColor="#4B5563" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$5.00 USD"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#1F2937" />
                    </LinearLayout>

                    <!-- Total a cancelar (Tarjeta destacada) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F0FDF4"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL A CANCELAR"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#166534" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tarifa transparente"
                                android:textSize="10sp"
                                android:textColor="#15803D" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$25.00"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#166534"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="USD"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#15803D" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. MÉTODO DE PAGO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Método de pago"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0B2545" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elige una opción"
                    android:textSize="11sp"
                    android:textColor="#6B7280" />
            </LinearLayout>

            <!-- Opción 1: Efectivo (Seleccionado) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="💵"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:background="#E0F2FE"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Efectivo"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pagar directamente en mano al técnico"
                            android:textSize="11sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Opción 2: Transferencia Directa o QR -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="🏦"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:background="#F1F5F9"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Transferencia Directa o QR"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Banco Agrícola, BAC, Chivo Wallet /\nTransfer365"
                            android:textSize="11sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. CALIFICA EL SERVICIO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Califica el servicio"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tu valoración fortalece la comunidad segura de técnicos en El Salvador."
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="14dp" />

                    <!-- Estrellas (5 estrellas grandes) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="6dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="32sp" android:textColor="#38BDF8" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="32sp" android:textColor="#38BDF8" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="32sp" android:textColor="#38BDF8" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="32sp" android:textColor="#38BDF8" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="32sp" android:textColor="#38BDF8" android:layout_marginHorizontal="6dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Excelente trabajo (5.0)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0369A1"
                        android:gravity="center"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="¿Qué destacó de su atención?"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="8dp" />

                    <!-- Chips de atributos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚡ Puntual"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545"
                                android:background="@drawable/bg_input_rounded"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="6dp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🧹 Trabajo limpio"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545"
                                android:background="@drawable/bg_input_rounded"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="6dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏷️ Tarifa justa"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545"
                                android:background="@drawable/bg_input_rounded"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="6dp"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🛡️ Amable y profesional"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545"
                                android:background="@drawable/bg_input_rounded"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Comentario adicional (opcional)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/etComentarioCalificacion"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="@drawable/bg_input_rounded"
                        android:hint="Escribe un comentario sobre tu experiencia con Roberto..."
                        android:textSize="12sp"
                        android:padding="10dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 6. BOTÓN PRINCIPAL: CONFIRMAR PAGO Y FINALIZAR -->
            <Button
                android:id="@+id/btnConfirmarPagoFinalizar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🛡️  Confirmar Pago y Finalizar"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0B2545"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transacción protegida por ChivoSeguro • Garantía de trabajo por 30 días"
                android:textSize="11sp"
                android:gravity="center"
                android:textColor="#9CA3AF"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true">
  <!-- Ajuste para presentación: títulos de 20sp y etiquetas compactas; se conserva el tamaño táctil y la escala de texto del teléfono. -->
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- CONTENEDOR PRINCIPAL SCROLLABLE -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
      <!-- 1. BARRA SUPERIOR -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="16dp">
        <ImageView
            android:id="@+id/btnRegresarHistorialChats"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_m3_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Regresar"
            android:minHeight="48dp"
            app:tint="@color/ui_text"/>
        <!-- Logo ChivoTrabajo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp">
          <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_marginEnd="4dp"
              android:src="@drawable/ic_m3_shield"
              app:tint="@color/ui_primary"
              android:importantForAccessibility="no"/>
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ChivoTrabajo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explorar Radar"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
          </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <!-- Campana -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_input_rounded"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:layout_marginEnd="10dp"
            android:contentDescription="Notificaciones"/>
        <!-- Avatar -->
        <ImageView
            android:id="@+id/btnPerfilHistorialChatsTop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/ui_brand"
            android:padding="8dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Perfil"
            android:minHeight="48dp"/>
      </LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mensajes" android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" android:textColor="@color/ui_text" android:padding="12dp"/>
<TextView android:id="@+id/tvEstadoChats" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cargando conversaciones…" android:textColor="@color/ui_text_secondary" android:padding="12dp"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/listaChats" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnBuscarRadarChats" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Buscar profesionales" style="@style/Widget.Chivo.Button.Secondary"/>
</LinearLayout>
  </ScrollView>
  <!-- 8. BARRA DE NAVEGACIÓN INFERIOR (MENSAJES) -->
  <!-- Material 3: barra de navegación con indicador, iconos y cinco destinos. -->
  <com.google.android.material.bottomnavigation.BottomNavigationView
      android:id="@+id/bottomNavigation"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      style="@style/Widget.Chivo.Navigation"
      app:menu="@menu/menu_activity_historial_chats"/>
</LinearLayout>

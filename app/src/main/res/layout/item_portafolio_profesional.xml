<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/ui_surface"
    style="@style/Widget.Chivo.Card">
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
    <!-- FOTO DEL TRABAJO -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="150dp">
      <ImageView
          android:id="@+id/ivFotoTrabajo"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@color/ui_outline"
          android:scaleType="centerCrop"
          android:src="@mipmap/ic_launcher"
          android:contentDescription="Foto del trabajo realizado"/>
      <!-- MENÚ DEL TRABAJO -->
      <TextView
          android:id="@+id/btnOpcionesTrabajo"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_gravity="top|end"
          android:layout_margin="8dp"
          android:gravity="center_vertical"
          android:text="⋮"
          android:textSize="22sp"
          android:textStyle="bold"
          android:textColor="#FFFFFF"
          android:background="#99000000"
          android:clickable="true"
          android:focusable="true"
          android:contentDescription="Opciones del trabajo"
          android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
          android:fontFamily="sans-serif-medium"
          android:minHeight="48dp"/>
    </FrameLayout>
    <!-- INFORMACIÓN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
      <TextView
          android:id="@+id/tvTituloTrabajo"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Título del trabajo"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/ui_text"
          android:layout_marginBottom="2dp"
          android:visibility="gone"
          android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
          android:fontFamily="sans-serif-medium"/>
      <TextView
          android:id="@+id/tvDescripcionTrabajo"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="Instalación eléctrica residencial"
          android:textSize="12sp"
          android:textColor="@color/ui_text_secondary"
          android:maxLines="2"
          android:ellipsize="end"
          android:layout_marginBottom="8dp"
          android:textAppearance="@style/TextAppearance.Material3.BodySmall"
          android:fontFamily="sans-serif"/>
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_m3_calendar"
            app:tint="@color/ui_primary"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/tvFechaTrabajo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="29 sep. 2026"
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- FOTO DEL TRABAJO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp">

            <ImageView
                android:id="@+id/ivFotoTrabajo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E5E7EB"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Foto del trabajo realizado" />

            <!-- MENÚ DEL TRABAJO -->
            <TextView
                android:id="@+id/btnOpcionesTrabajo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:gravity="center"
                android:text="⋮"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#99000000"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Opciones del trabajo" />

        </FrameLayout>


        <!-- INFORMACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvDescripcionTrabajo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instalación eléctrica residencial"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0B2545"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvFechaTrabajo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="29 sep. 2026"
                    android:textSize="11sp"
                    android:textColor="#6B7280" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
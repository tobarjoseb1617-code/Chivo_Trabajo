<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F5F7"
    android:fitsSystemWindows="true">

    <!-- CONTENEDOR PRINCIPAL SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. BARRA SUPERIOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- Badge ChivoTrabajo PRO -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="14sp"
                        android:layout_marginEnd="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ChivoTrabajo"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#1F2937"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" PRO "
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="#0B2545"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="1dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Panel de Trabajo"
                            android:textSize="10sp"
                            android:textColor="#6B7280" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Estado Disponible -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Disponible"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#059669"
                    android:background="#DCFCE7"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="10dp" />

                <!-- Campana -->
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input_rounded"
                    android:padding="8dp"
                    android:src="@drawable/ic_notificacion"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Notificaciones" />

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/btnPerfilProTop"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#0B2545"
                    android:padding="8dp"
                    android:src="@mipmap/ic_launcher"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Perfil" />


            </LinearLayout>

            <!-- 2. TARJETA DE PERFIL DEL PROFESIONAL -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- INFORMACIÓN DEL PROFESIONAL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <!-- FOTO DEL PROFESIONAL -->
                        <RelativeLayout
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_marginEnd="12dp">

                            <ImageView
                                android:id="@+id/ivFotoProfesionalInicio"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@mipmap/ic_launcher"
                                android:background="#E5E7EB"
                                android:scaleType="centerCrop"
                                android:contentDescription="Foto del profesional" />

                            <!-- INDICADOR DISPONIBLE -->
                            <View
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:background="#16A34A" />

                        </RelativeLayout>

                        <!-- DATOS -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- NOMBRE + ESTADO -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="3dp">

                                <TextView
                                    android:id="@+id/tvNombreProfesionalInicio"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Profesional"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="#0B2545"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PRO"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="#0369A1"
                                    android:background="#E0F2FE"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="3dp" />

                            </LinearLayout>

                            <!-- ESPECIALIDAD -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fontanería y gasfitería"
                                android:textSize="12sp"
                                android:textColor="#4B5563"
                                android:layout_marginBottom="6dp" />

                            <!-- VERIFICACIÓN -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ DUI Verificado"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#15803D"
                                android:background="#DCFCE7"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="3dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- DISPONIBILIDAD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F0FDF4"
                        android:padding="10dp">

                        <View
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="#16A34A"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disponible para trabajar"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#166534" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recibiendo nuevas solicitudes"
                                android:textSize="10sp"
                                android:textColor="#4D7C0F" />

                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchDisponibilidadPro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 3. TARJETA: SERVICIO EN CURSO AHORA MISMO -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardServicioEnCursoPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#0B2545"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ENCABEZADO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="●  SERVICIO EN CURSO"
                            android:textColor="#34D399"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#1E3A8A"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="#3821"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- SERVICIO, CLIENTE Y PRECIO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <!-- Información del servicio -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Fuga bajo fregadero"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="👤 Carlos Rivera"
                                android:textColor="#CBD5E1"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- Precio -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="$25.00"
                            android:textColor="#34D399"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- UBICACIÓN Y ESTADO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="#162F59"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <!-- Dirección -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📍  Residencial Cumbres de Cuscatlán"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Antiguo Cuscatlán"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />

                        <!-- Estado del recorrido -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🚗  En camino · 3.4 km"
                                android:textColor="#93C5FD"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12 min"
                                android:textColor="#CBD5E1"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>


                    <!-- BOTONES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnVerRutaGps"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#1D4ED8"
                            android:text="🗺️  Ver ruta"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnAbrirChatPro"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#FFFFFF"
                            android:text="💬  Abrir chat"
                            android:textColor="#0B2545"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 4. OPORTUNIDADES EN VIVO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Oportunidades en vivo"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#0B2545" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 cerca"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#047857"
                    android:background="#DCFCE7"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 km"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:background="#F1F5F9"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>


            <!-- TARJETA OPORTUNIDAD 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ESTADO Y TIEMPO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥  URGENTE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#B91C1C"
                            android:background="#FEE2E2"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hace 8 min"
                            android:textSize="11sp"
                            android:textColor="#94A3B8" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:background="#F8FAFC"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Presupuesto"
                                android:textSize="9sp"
                                android:textColor="#94A3B8" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$30 – $45"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- SERVICIO -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fuga urgente en cisterna"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="5dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍  Col. Escalón  •  1.8 km"
                        android:textSize="12sp"
                        android:textColor="#475569"
                        android:layout_marginBottom="10dp" />

                    <!-- DESCRIPCIÓN -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Se necesita cambio de flotador y empaque de presión de emergencia en cisterna subterránea..."
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#64748B"
                        android:layout_marginBottom="14dp" />

                    <!-- BOTONES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPropuestaRapida1"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="⚡  Propuesta rápida"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#0B2545" />

                        <Button
                            android:id="@+id/btnDetallesOp1"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginStart="6dp"
                            android:text="Detalles"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545"
                            android:backgroundTint="#E2E8F0"
                            android:paddingHorizontal="16dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- TARJETA OPORTUNIDAD 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ESTADO Y TIEMPO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROGRAMADO"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#1D4ED8"
                            android:background="#DBEAFE"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hace 25 min"
                            android:textSize="11sp"
                            android:textColor="#94A3B8" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:background="#F8FAFC"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="5dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Presupuesto"
                                android:textSize="9sp"
                                android:textColor="#94A3B8" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$20 – $35"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0B2545" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- SERVICIO -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Instalación de grifería y trampa"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0B2545"
                        android:layout_marginBottom="5dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍  Santa Tecla  •  3.2 km"
                        android:textSize="12sp"
                        android:textColor="#475569"
                        android:layout_marginBottom="10dp" />

                    <!-- DESCRIPCIÓN -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cliente ya compró grifo monomando y trampa de PVC nueva para lavatrastos de cocina. Requiere..."
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#64748B"
                        android:layout_marginBottom="14dp" />

                    <!-- BOTONES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPropuestaRapida2"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="⚡  Propuesta rápida"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#0B2545" />

                        <Button
                            android:id="@+id/btnDetallesOp2"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginStart="6dp"
                            android:text="Detalles"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#0B2545"
                            android:backgroundTint="#E2E8F0"
                            android:paddingHorizontal="16dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- 5. BARRA DE NAVEGACIÓN INFERIOR (PROFESIONAL) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:id="@+id/navInicioPro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inicio" android:textSize="9sp" android:textStyle="bold" android:textColor="#0284C7" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSolicitudesPro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Solicitudes" android:textSize="9sp" android:textColor="#6B7280" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navServiciosPro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛠️" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Servicios" android:textSize="9sp" android:textColor="#6B7280" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMensajesPro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💬" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mensajes" android:textSize="9sp" android:textColor="#6B7280" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPerfilPro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👤" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Perfil" android:textSize="9sp" android:textColor="#6B7280" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

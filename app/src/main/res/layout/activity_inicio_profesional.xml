                android:layout_marginStart="6dp"
                android:text="Detalles"
                style="@style/Widget.Chivo.Button.Secondary"
                android:minHeight="48dp"
                android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

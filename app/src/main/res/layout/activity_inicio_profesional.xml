<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- BARRA SUPERIOR -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

          <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_marginEnd="4dp"
              android:src="@drawable/ic_m3_shield"
              app:tint="@color/ui_primary"
              android:importantForAccessibility="no"/>

          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ChivoTrabajo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel de Trabajo"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
          </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_input_rounded"
            android:padding="8dp"
            android:src="@drawable/ic_m3_notifications"
            android:layout_marginEnd="10dp"
            android:contentDescription="Notificaciones"
            app:tint="@color/ui_text_secondary"/>

        <ImageView
            android:id="@+id/btnPerfilProTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="0dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Perfil"/>
      </LinearLayout>

      <!-- TARJETA DE PERFIL DEL PROFESIONAL -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          app:cardBackgroundColor="@color/ui_surface"
          style="@style/Widget.Chivo.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="14dp">

            <RelativeLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="12dp">

              <ImageView
                  android:id="@+id/ivFotoProfesionalInicio"
                  android:layout_width="60dp"
                  android:layout_height="60dp"
                  android:src="@mipmap/ic_launcher"
                  android:background="@android:color/transparent"
                  android:padding="0dp"
                  android:scaleType="centerCrop"
                  android:contentDescription="Foto del profesional"/>
              <View
                  android:id="@+id/viewIndicadorDisponibilidadPro"
                  android:layout_width="15dp"
                  android:layout_height="15dp"
                  android:layout_alignParentEnd="true"
                  android:layout_alignParentBottom="true"
                  android:background="@drawable/bg_indicador_disponibilidad"/>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginBottom="3dp">

                <TextView
                    android:id="@+id/tvNombreProfesionalInicio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Profesional"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRO"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_primary"
                    android:background="@drawable/bg_m3_info"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"/>
              </LinearLayout>

              <TextView
                  android:id="@+id/tvCategoriaProfesionalInicio"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text=""
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:layout_marginBottom="6dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="DUI Verificado"
                  android:textSize="12sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_success"
                  android:background="@drawable/bg_m3_success"
                  android:paddingHorizontal="7dp"
                  android:paddingVertical="3dp"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"
                  android:maxLines="1"/>
            </LinearLayout>
          </LinearLayout>

          <!-- DISPONIBILIDAD -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@drawable/bg_m3_success"
              android:padding="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:id="@+id/tvEstadoDisponibilidadPro"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="No disponible para trabajar"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_success"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>

              <TextView
                  android:id="@+id/tvDescripcionDisponibilidadPro"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="No estás recibiendo nuevas solicitudes"
                  android:textSize="12sp"
                  android:textColor="@color/ui_success"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>

            <Switch
                android:id="@+id/switchDisponibilidadPro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- SERVICIO EN CURSO -->
      <com.google.android.material.card.MaterialCardView
          android:id="@+id/cardServicioEnCursoPro"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="20dp"
          android:clickable="true"
          android:focusable="true"
          app:cardBackgroundColor="@color/ui_brand"
          style="@style/Widget.Chivo.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:layout_marginBottom="12dp"
              android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●  servicio en curso"
                android:textColor="#34D399"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1E3A8A"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="#3821"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Fuga bajo fregadero"
                  android:textColor="#FFFFFF"
                  android:textSize="17sp"
                  android:textStyle="bold"
                  android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                  android:fontFamily="sans-serif-medium"/>

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="3dp"
                  android:text="Carlos Rivera"
                  android:textColor="#CBD5E1"
                  android:textSize="12sp"
                  android:drawableStart="@drawable/ic_m3_person"
                  android:drawableTint="@color/ui_primary"
                  android:drawablePadding="8dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="$25.00"
                android:textColor="#34D399"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="12dp"
              android:background="@color/ui_brand"
              android:orientation="vertical"
              android:padding="11dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Residencial Cumbres de Cuscatlán"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_m3_location"
                android:drawableTint="@color/ui_primary"
                android:drawablePadding="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Antiguo Cuscatlán"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

              <TextView
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:text="En camino · 3.4 km"
                  android:textColor="#93C5FD"
                  android:textSize="12sp"
                  android:drawableStart="@drawable/ic_m3_car"
                  android:drawableTint="@color/ui_primary"
                  android:drawablePadding="8dp"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="12 min"
                  android:textColor="#CBD5E1"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
          </LinearLayout>

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerRutaGps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Ver ruta"
                style="@style/Widget.Chivo.Button.Secondary"
                android:minHeight="48dp"
                app:icon="@drawable/ic_m3_map"
                app:iconSize="20dp"
                android:textSize="14sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirChatPro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Abrir chat"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"
                app:icon="@drawable/ic_m3_chat"
                app:iconSize="20dp"
                android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- OPORTUNIDADES EN VIVO -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Oportunidades en vivo"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 cerca"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ui_success"
            android:background="@drawable/bg_m3_success"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 km"
            android:textSize="12sp"
            android:textColor="@color/ui_text_secondary"
            android:background="@color/ui_surface_variant"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:fontFamily="sans-serif"/>
      </LinearLayout>

      <!-- TARJETA OPORTUNIDAD 1 -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardBackgroundColor="@color/ui_surface"
          style="@style/Widget.Chivo.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Urgente"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/ui_error"
                android:background="@drawable/bg_m3_error"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_m3_bolt"
                android:drawableTint="@color/ui_primary"
                android:drawablePadding="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hace 8 min"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:background="@color/ui_background"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp">

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Presupuesto"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="$30 – $45"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
          </LinearLayout>

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Fuga urgente en cisterna"
              android:textSize="15sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="5dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
              android:fontFamily="sans-serif-medium"/>

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Col. Escalón  •  1.8 km"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="10dp"
              android:drawableStart="@drawable/ic_m3_location"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Se necesita cambio de flotador y empaque de presión de emergencia en cisterna subterránea..."
              android:textSize="12sp"
              android:lineSpacingExtra="2dp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="14dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPropuestaRapida1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Propuesta rápida"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"
                app:icon="@drawable/ic_m3_bolt"
                app:iconSize="20dp"
                android:textSize="14sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetallesOp1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Detalles"
                style="@style/Widget.Chivo.Button.Secondary"
                android:minHeight="48dp"
                android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- TARJETA OPORTUNIDAD 2 -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="20dp"
          app:cardBackgroundColor="@color/ui_surface"
          style="@style/Widget.Chivo.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Programado"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_primary"
                android:background="@drawable/bg_m3_info"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hace 25 min"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:background="@color/ui_background"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp">

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Presupuesto"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="$20 – $35"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
          </LinearLayout>

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Instalación de grifería y trampa"
              android:textSize="15sp"
              android:textStyle="bold"
              android:textColor="@color/ui_text"
              android:layout_marginBottom="5dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
              android:fontFamily="sans-serif-medium"/>

          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Santa Tecla  •  3.2 km"
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="10dp"

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnVolverAdmin"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:src="@drawable/ic_m3_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Regresar"
                app:tint="@color/ui_text"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gestión de solicitudes"
                    android:textColor="@color/ui_text"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Consulta todas las solicitudes registradas"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="13sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Cantidad de solicitudes -->
        <TextView
            android:id="@+id/tvCantidadSolicitudesAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Solicitudes encontradas: 0"
            android:textColor="@color/ui_text"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <!-- Filtros -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contenedorFiltrosAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroTodas"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todas"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroPendientes"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Pendientes"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroAsignadas"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Asignadas"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroCompletadas"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Completadas"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFiltroCanceladas"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Canceladas"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Cargando -->
        <ProgressBar
            android:id="@+id/progressSolicitudesAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:visibility="gone"/>

        <!-- Sin solicitudes -->
        <TextView
            android:id="@+id/tvSinSolicitudesAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="No hay solicitudes para mostrar"
            android:textColor="@color/ui_text_secondary"
            android:textSize="15sp"
            android:visibility="gone"/>

        <!-- Lista de solicitudes -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSolicitudesAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

<?xml version='1.0' encoding='utf-8'?>
<!-- Apariencia: los colores compartidos cambian con la paleta clara u oscura. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true">
  <!-- Ajuste para presentación: títulos de 20sp y etiquetas compactas; se conserva el tamaño táctil y la escala de texto del teléfono. -->
  <!-- Material 3: tipografía por roles, superficies sobrias y controles accesibles; se conservan los IDs de los formularios. -->
  <!-- CONTENEDOR PRINCIPAL SCROLLABLE -->
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
      <!-- 1. BARRA SUPERIOR -->
      <com.google.android.material.appbar.MaterialToolbar
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@color/ui_surface"
          android:elevation="0dp"
          android:minHeight="64dp"
          app:contentInsetStart="0dp"
          app:contentInsetEnd="0dp">
        <!-- App bar Material 3; los botones de regreso conservan sus listeners. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:minHeight="64dp">
          <ImageView
              android:id="@+id/btnRegresarServicios"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:padding="12dp"
              android:src="@drawable/ic_m3_back"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:clickable="true"
              android:focusable="true"
              android:layout_marginEnd="8dp"
              android:contentDescription="Regresar"
              android:minHeight="48dp"
              app:tint="@color/ui_text"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Servicios"
              android:textSize="20sp"
              android:textStyle="normal"
              android:textColor="@color/ui_text"
              android:drawableStart="@drawable/ic_m3_build"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
              android:fontFamily="sans-serif-medium"
              android:maxLines="1"
              android:ellipsize="end"/>
          <View
              android:layout_width="0dp"
              android:layout_height="0dp"
              android:layout_weight="1"/>
          <!-- Campana -->
          <ImageView
              android:layout_width="36dp"
              android:layout_height="36dp"
              android:background="@drawable/bg_input_rounded"
              android:padding="8dp"
              android:src="@android:drawable/ic_menu_agenda"
              android:layout_marginEnd="10dp"
              android:contentDescription="Notificaciones"/>
          <!-- Avatar -->
          <ImageView
              android:id="@+id/btnPerfilServiciosTop"
              android:layout_width="48dp"
              android:layout_height="48dp"
              android:background="@color/ui_brand"
              android:padding="8dp"
              android:src="@mipmap/ic_launcher"
              android:contentDescription="Perfil"
              android:minHeight="48dp"/>
        </LinearLayout>
      </com.google.android.material.appbar.MaterialToolbar>
      <!-- 2. BANNER DE GARANTÍA CHIVOSEGURO ACTIVA -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/bg_m3_success"
          android:padding="12dp"
          android:layout_marginBottom="14dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_m3_shield"
            app:tint="@color/ui_primary"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Garantía ChivoSeguro Activa"
              android:textSize="13sp"
              android:textStyle="bold"
              android:textColor="@color/ui_success"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="30 días de cobertura y pago protegido en USD."
              android:textSize="12sp"
              android:textColor="@color/ui_success"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➔"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/ui_success"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
      <!-- 3. BARRA DE BÚSQUEDA Y FILTRO -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:orientation="horizontal"
          android:background="@drawable/bg_input_rounded"
          android:gravity="center_vertical"
          android:paddingHorizontal="16dp"
          android:layout_marginBottom="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_m3_search"
            app:tint="@color/ui_primary"
            android:importantForAccessibility="no"/>
        <EditText
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Buscar por código, oficio o técnico..."
            android:textSize="14sp"
            android:inputType="text"
            android:minHeight="48dp"/>
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_m3_tune"
            app:tint="@color/ui_primary"
            android:importantForAccessibility="no"/>
      </LinearLayout>
      <!-- 4. FILTROS (CHIPS) -->
      <HorizontalScrollView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:scrollbars="none"
          android:layout_marginBottom="16dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
          <!-- En curso (Seleccionado) -->
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@color/ui_brand"
              android:paddingHorizontal="16dp"
              android:paddingVertical="8dp"
              android:layout_marginEnd="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En curso"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="#0284C7"
                android:textColor="#FFFFFF"
                android:text="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <!-- Finalizados -->
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@color/ui_surface"
              android:paddingHorizontal="16dp"
              android:paddingVertical="8dp"
              android:layout_marginEnd="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finalizados"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:layout_marginEnd="6dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@color/ui_outline"
                android:textColor="@color/ui_text_secondary"
                android:text="3"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <!-- Cancelados -->
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@color/ui_surface"
              android:paddingHorizontal="16dp"
              android:paddingVertical="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelados"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:layout_marginEnd="6dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@color/ui_outline"
                android:textColor="@color/ui_text_secondary"
                android:text="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
        </LinearLayout>
      </HorizontalScrollView>
      <!-- 5. SECCIÓN: SERVICIO ACTIVO (TIEMPO REAL) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Servicio activo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text_secondary"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiempo Real"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/ui_primary"
            android:background="@drawable/bg_m3_info"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"/>
      </LinearLayout>
      <!-- Tarjeta Servicio Activo -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="24dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reparación de Fuga en Fregadero"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$25.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/ui_success"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#SRV-2041 • Plomería Residencial"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ChivoSeguro"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_success"
                android:drawableStart="@drawable/ic_m3_shield"
                android:drawableTint="@color/ui_primary"
                android:drawablePadding="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <!-- Estado en camino -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="@drawable/bg_m3_success"
              android:padding="10dp"
              android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="En camino hacia tu ubicación\nLlegada estimada en 15 min (2:30 PM)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_success"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️"
                android:textSize="20sp"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"/>
          </LinearLayout>
          <!-- Info Técnico -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="10dp">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:layout_marginEnd="10dp"
                android:contentDescription="Roberto Méndez"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:gravity="start">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Roberto Méndez"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text"
                    android:layout_marginEnd="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verificado"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#059669"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:contentDescription="Identidad verificada por DUI"
                    android:layout_marginTop="4dp"/>
              </LinearLayout>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="4.9 (84)"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_warning"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:background="@drawable/bg_m3_info"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_m3_phone"
                app:tint="@color/ui_primary"
                android:importantForAccessibility="no"/>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:background="@drawable/bg_m3_info"
                android:src="@drawable/ic_m3_chat"
                app:tint="@color/ui_primary"
                android:importantForAccessibility="no"/>
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Residencial Cumbres de Cuscatlán, Casa #14, Antigu..."
              android:textSize="12sp"
              android:textColor="@color/ui_text_secondary"
              android:layout_marginBottom="14dp"
              android:drawableStart="@drawable/ic_m3_location"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.BodySmall"
              android:fontFamily="sans-serif"/>
          <!-- Botones Seguimiento y Ver Orden -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeguimientoServicio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Seguimiento"
                android:layout_marginEnd="8dp"
                style="@style/Widget.Chivo.Button"
                android:minHeight="48dp"
                android:textSize="14sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerOrdenServicio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ver Orden"
                style="@style/Widget.Chivo.Button.Secondary"
                android:minHeight="48dp"
                app:icon="@drawable/ic_m3_list"
                app:iconSize="20dp"
                android:textSize="14sp"/>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- 6. SECCIÓN: HISTORIAL RECIENTE -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Historial reciente"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ui_text_secondary"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Más recientes ∨"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ui_primary"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:fontFamily="sans-serif-medium"/>
      </LinearLayout>
      <!-- Historial 1: Revisión y Cambio de Pastilla Térmica -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardBackgroundColor="@color/ui_surface"
          android:layout_marginBottom="14dp"
          style="@style/Widget.Chivo.Card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#SRV-1988 • Completado el 12 Feb"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$35.00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
          </LinearLayout>
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Revisión y Cambio de Pastilla Térmica"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ui_text"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USD Pagado"
                android:textSize="12sp"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:fontFamily="sans-serif"/>
          </LinearLayout>
          <!-- Garantía vigente -->
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Garantía vigente (27 días restantes)"
              android:textSize="13sp"
              android:textStyle="bold"
              android:textColor="@color/ui_success"
              android:background="@drawable/bg_m3_success"
              android:paddingHorizontal="8dp"
              android:paddingVertical="3dp"
              android:layout_marginBottom="10dp"
              android:drawableStart="@drawable/ic_m3_shield"
              android:drawableTint="@color/ui_primary"
              android:drawablePadding="8dp"
              android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
              android:fontFamily="sans-serif-medium"/>
          <!-- Técnico y Estrellas -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/ui_outline"
                android:layout_marginEnd="8dp"
                android:contentDescription="David Henríquez"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="David Henríquez"
                  android:textSize="13sp"
                  android:textStyle="bold"
                  android:textColor="@color/ui_text"
                  android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                  android:fontFamily="sans-serif-medium"/>
              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Electricidad Certificada"
                  android:textSize="12sp"
                  android:textColor="@color/ui_text_secondary"
                  android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                  android:fontFamily="sans-serif"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★★★★★"
                android:textSize="14sp"

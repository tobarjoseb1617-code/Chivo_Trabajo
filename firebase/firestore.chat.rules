// Integrar este bloque dentro de match /databases/{database}/documents
// de las reglas existentes. No reemplazar las reglas de Usuario/profesionales.
match /conversaciones/{chatId} {
  function autenticado() { return request.auth != null; }
  function miembro() { return autenticado() && request.auth.uid in resource.data.participantes; }
  allow get: if autenticado() &&
    (!exists(/databases/$(database)/documents/conversaciones/$(chatId)) || miembro());
  allow list: if miembro();
  allow create: if autenticado()
    && request.resource.data.keys().hasOnly(['participantes', 'nombres', 'ultimoMensaje', 'actualizadoEn'])
    && request.resource.data.participantes is list
    && request.resource.data.participantes.size() == 2
    && request.resource.data.participantes[0] is string
    && request.resource.data.participantes[1] is string
    && request.resource.data.participantes[0] != request.resource.data.participantes[1]
    && request.auth.uid in request.resource.data.participantes
    && exists(/databases/$(database)/documents/Usuario/$(request.resource.data.participantes[0]))
    && exists(/databases/$(database)/documents/Usuario/$(request.resource.data.participantes[1]))
    && request.resource.data.nombres is map
    && request.resource.data.nombres.keys().hasOnly(request.resource.data.participantes)
    && request.resource.data.ultimoMensaje == ''
    && request.resource.data.actualizadoEn == request.time;
  allow update: if miembro()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoMensaje', 'actualizadoEn'])
    && request.resource.data.ultimoMensaje is string
    && request.resource.data.ultimoMensaje.size() <= 4000
    && request.resource.data.actualizadoEn == request.time;
  allow delete: if false;

  match /mensajes/{mensajeId} {
    function participante() {
      return request.auth != null && request.auth.uid in
        get(/databases/$(database)/documents/conversaciones/$(chatId)).data.participantes;
    }
    allow read: if participante();
    allow create: if participante()
      && request.resource.data.keys().hasOnly(['remitenteUid', 'tipo', 'texto', 'archivoUrl', 'mimeType', 'creadoEn'])
      && request.resource.data.remitenteUid == request.auth.uid
      && request.resource.data.creadoEn == request.time
      && request.resource.data.texto is string
      && request.resource.data.archivoUrl is string
      && request.resource.data.mimeType is string
      && ((request.resource.data.tipo == 'texto'
        && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 4000
        && request.resource.data.archivoUrl == '' && request.resource.data.mimeType == '')
        || (request.resource.data.tipo in ['imagen', 'video', 'audio']
        && request.resource.data.texto == ''
        && request.resource.data.archivoUrl.matches('https://res[.]cloudinary[.]com/.*')
        && ((request.resource.data.tipo == 'imagen' && request.resource.data.mimeType.matches('image/.*'))
          || (request.resource.data.tipo == 'video' && request.resource.data.mimeType.matches('video/.*'))
          || (request.resource.data.tipo == 'audio' && request.resource.data.mimeType.matches('audio/.*')))))
      && getAfter(/databases/$(database)/documents/conversaciones/$(chatId)).data.actualizadoEn == request.time;
    allow update, delete: if false;
  }
}
